diff --git a/drivers/media/platform/qcom/venus/hfi_helper.h b/drivers/media/platform/qcom/venus/hfi_helper.h
index f44059f19..c65cf1dee 100644
--- a/drivers/media/platform/qcom/venus/hfi_helper.h
+++ b/drivers/media/platform/qcom/venus/hfi_helper.h
@@ -568,6 +568,25 @@ struct hfi_buffer_info {
 	u32 extradata_addr;
 };
 
+/*
+ * m52xq: Iris2 (HFI 6xx, SM7325) encoder properties as the Qualcomm msm_vidc driver sends them:
+ * the frame QP is a CONFIG with packed I/P/B values and an enable mask, bitrates are set for all
+ * layers (layer id 0xff); PARAM_VENC_SESSION_QP is not packed for 6xx at all.
+ */
+#define HFI_PROPERTY_CONFIG_VENC_FRAME_QP_6XX		0x2006012
+#define HFI_PROPERTY_PARAM_VENC_BITRATE_TYPE_6XX	0x2005031
+#define HFI_6XX_ALL_LAYER_ID				0xff
+#define HFI_6XX_QP_ENABLE_I				0x1
+#define HFI_6XX_QP_ENABLE_P				0x2
+#define HFI_6XX_QP_ENABLE_B				0x4
+
+struct hfi_frame_qp_6xx {
+	u32 qp_packed;
+	u32 layer_id;
+	u32 enable;
+	u32 reserved[3];
+};
+
 struct hfi_bitrate {
 	u32 bitrate;
 	u32 layer_id;
