 	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_H264 ||
@@ -914,6 +927,35 @@ static int venc_set_properties(struct venus_inst *inst)
 			return ret;
 	}
 
+	/*
+	 * m52xq: Iris2 (HFI 6xx) never got PARAM_VENC_SESSION_QP (the 4xx packer returns -ENOTSUPP, which is
+	 * ignored): send the frame QP as msm_vidc does - CONFIG_VENC_FRAME_QP with packed I/P/B and an enable
+	 * mask, for all layers. With rate control on only when the client set the QP away from the default.
+	 */
+	if (IS_V6(inst->core) && inst->fmt_cap->pixfmt != V4L2_PIX_FMT_VP8) {
+		struct hfi_frame_qp_6xx fqp = {};
+		u32 qi, qpp, qb;
+
+		if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC) {
+			qi = ctr->hevc_i_qp;
+			qpp = ctr->hevc_p_qp;
+			qb = ctr->hevc_b_qp;
+		} else {
+			qi = ctr->h264_i_qp;
+			qpp = ctr->h264_p_qp;
+			qb = ctr->h264_b_qp;
+		}
+		fqp.qp_packed = qi | qpp << 8 | qb << 16;
+		fqp.layer_id = HFI_6XX_ALL_LAYER_ID;
+		fqp.enable = HFI_6XX_QP_ENABLE_I | HFI_6XX_QP_ENABLE_P | HFI_6XX_QP_ENABLE_B;
+		if (rate_control == HFI_RATE_CONTROL_OFF) {
+			ret = hfi_session_set_property(inst, HFI_PROPERTY_CONFIG_VENC_FRAME_QP_6XX, &fqp);
+			if (ret)
+				return ret;
+			dev_dbg(inst->core->dev, "m52xq: frame QP %u/%u/%u (rate control off)\n", qi, qpp, qb);
+		}
+	}
+
 	ptype = HFI_PROPERTY_PARAM_VENC_SESSION_QP;
 	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC) {
 		quant.qp_i = ctr->hevc_i_qp;
