#!/usr/bin/python3
# M52XQ (Phosh): own idle suspend. gnome-settings-daemon (gsd-power) never suspended the phone in 9.5 h on the battery
# (suspend_stats.success = 0, no inhibitor, Phosh's idle monitor works: a 20 s watch fired in 20 s), so this session
# service does it: the idle watch of Phosh (org.gnome.Mutter.IdleMonitor, ext-idle-notify of phoc) fires after the time
# set in Settings ("Automatic suspend", on battery) and the phone is suspended through logind (org.freedesktop.login1
# Suspend, allowed for the active session). It does not suspend
#   - on a charger (as the gsd-power settings: only "on battery"),
#   - while a call exists (ModemManager Call objects that are not terminated),
#   - while a media player is playing (MPRIS),
#   - while a "block" inhibitor of logind holds the sleep (e.g. an ssh session, apk): logind refuses the suspend.
# If the phone wakes up without any user input (modem, alarm, USB) it is suspended again after M52XQ_RESUME_GRACE_S
# ("dark wake-up": the display that phoc switches on after the resume is switched off at once through
# org.gnome.Mutter.DisplayConfig PowerSaveMode and kept off until a key / the touchscreen is used or a call arrives;
# a wake-up by the power key, the volume keys or the touchscreen is not dark).
# Environment: M52XQ_IDLE_SUSPEND_S overrides the time of the settings (tests).
import os
import subprocess
import sys
import datetime
import glob
import time

import gi
from gi.repository import Gio, GLib

RESUME_GRACE_S = int(os.environ.get('M52XQ_RESUME_GRACE_S', '8'))
# m52xq (2026-11-14): Telegram Desktop needs more than 8 s after a Wi-Fi wake-up to reconnect and fetch a message / call
# (they all arrived only when the user woke the phone): as pm-Plasma, a dark wake-up lasts 45 s while Telegram runs
TELEGRAM_GRACE_S = int(os.environ.get('M52XQ_TELEGRAM_GRACE_S', '45'))
TELEGRAM_MIN_SLEEP_S = int(os.environ.get('M52XQ_TELEGRAM_MIN_SLEEP_S', '60'))
DARK_S = 0.5    # while the phone is on after a wake-up without the user, switch the display off every DARK_S seconds
POWER_SCHEMA = 'org.gnome.settings-daemon.plugins.power'
IDLE_BUS, IDLE_PATH, IDLE_IFACE = 'org.gnome.Mutter.IdleMonitor', '/org/gnome/Mutter/IdleMonitor/Core', 'org.gnome.Mutter.IdleMonitor'


def log(msg):
    print('m52xq-idle-suspend: ' + msg, flush=True)


session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
settings = Gio.Settings.new(POWER_SCHEMA)

state = {'idle': False, 'resumed_at': 0.0, 'active_since_resume': True, 'watch_idle': None, 'watch_active': None,
         'timeout_s': 0, 'recheck_id': 0, 'dark': False, 'dark_id': 0, 'dark_ons': [], 'dark_mon': None}


def sync_call(conn, bus, path, iface, method, args=None, sig=None, timeout=5000):
    return conn.call_sync(bus, path, iface, method, GLib.Variant(sig, args) if sig else None, None,
                          Gio.DBusCallFlags.NONE, timeout, None)


def get_prop(conn, bus, path, iface, prop):
    r = sync_call(conn, bus, path, 'org.freedesktop.DBus.Properties', 'Get', (iface, prop), '(ss)')
    return r.unpack()[0]


def timeout_s():
    t = os.environ.get('M52XQ_IDLE_SUSPEND_S')
    if t:
        return int(t)
    if settings.get_string('sleep-inactive-battery-type') != 'suspend':
        return 0
    return settings.get_int('sleep-inactive-battery-timeout')


def on_battery():
    try:
        return bool(get_prop(system, 'org.freedesktop.UPower', '/org/freedesktop/UPower', 'org.freedesktop.UPower', 'OnBattery'))
    except GLib.Error as e:
        log('UPower: %s' % e.message)
        return False


MM_BUS = 'org.freedesktop.ModemManager1'
MM_CALL = 'org.freedesktop.ModemManager1.Call'
MM_VOICE = 'org.freedesktop.ModemManager1.Modem.Voice'


def call_busy():
    """A call that is not terminated exists. m52xq (2026-11-14): an incoming call was not seen for 50 s (the display
    blinked: the call screen switched it on, the dark wake-up off; the phone was even suspended during the ringing).
    Now: the calls of every modem (Modem.Voice.Calls, as mmcli) and the Call objects; the state of each call is read
    from the call itself; a D-Bus error counts as busy (better awake than asleep during a call)."""
    try:
        r = sync_call(system, MM_BUS, '/org/freedesktop/ModemManager1', 'org.freedesktop.DBus.ObjectManager',
                      'GetManagedObjects')
    except GLib.Error as e:
        if 'ServiceUnknown' in e.message or 'NameHasNoOwner' in e.message:
            return False    # no ModemManager, no calls
        log('call check: ModemManager does not answer (%s): counted as a call' % e.message)
        return True
    calls = set()
    for path, ifaces in r.unpack()[0].items():
        if MM_CALL in ifaces:
            calls.add(path)
        voice = ifaces.get(MM_VOICE)
        if voice:
            calls.update(voice.get('Calls', []))
    for path in calls:
        try:
            st = get_prop(system, MM_BUS, path, MM_CALL, 'State')
        except GLib.Error as e:
            if 'UnknownObject' in e.message or 'does not exist' in e.message:
                continue    # removed meanwhile
            log('call check: %s does not answer (%s): counted as a call' % (path, e.message))
            return True
        if st not in (0, 7):    # unknown / terminated
            return True
    return False


RTC_WAKEALARM = '/sys/class/rtc/rtc0/wakealarm'
ALARM_EARLY_S = 15        # wake up this long before an alarm of gnome-clocks
ALARM_MAX_AHEAD_S = 8 * 86400


def next_alarm():
    """(epoch of the next alarm of gnome-clocks, ring minutes) or None. m52xq (2026-11-14): gnome-clocks does not wake the
    phone itself, an alarm in the sleep only rang when the user woke the phone. days: 0 = Monday .. 6 = Sunday (empty = once)."""
    try:
        alarms = Gio.Settings.new('org.gnome.clocks').get_value('alarms').unpack()
    except Exception as e:    # schema missing etc.
        log('alarms: %s' % e)
        return None
    now = datetime.datetime.now()
    best = None
    for a in alarms:
        if not a.get('active', True):
            continue
        try:
            hour, minute = int(a['hour']), int(a['minute'])
        except (KeyError, ValueError):
            continue
        days = list(a.get('days') or [])
        for ahead in range(8):
            day = now.date() + datetime.timedelta(days=ahead)
            t = datetime.datetime.combine(day, datetime.time(hour, minute))
            if t <= now:
                continue
            if days and day.weekday() not in days:
                continue
            ts = t.timestamp()
            if best is None or ts < best[0]:
                best = (ts, int(a.get('ring_minutes', 5) or 5))
            break
    return best


def set_rtc_alarm():
    """Before the sleep: RTC wake-up ALARM_EARLY_S before the next alarm (0 = none)."""
    nxt = next_alarm()
    state['alarm_at'] = nxt[0] if nxt else 0
    state['alarm_ring_s'] = nxt[1] * 60 if nxt else 0
    try:
        with open(RTC_WAKEALARM, 'w') as f:
            f.write('0')
        if nxt and nxt[0] - time.time() < ALARM_MAX_AHEAD_S:
            # m52xq r4 (2026-11-17): RELATIVE "+N" as on the classic port. The pm8xxx RTC of the M52 counts from its own
            # epoch (~31 days after 1970 while the system time is 2026): an absolute system time written here woke the
            # phone only after decades, the 22:44 alarm rang only when the user woke the phone with the power key.
            with open(RTC_WAKEALARM, 'w') as f:
                f.write('+%d' % int(max(nxt[0] - ALARM_EARLY_S - time.time(), 5)))
            log('RTC wake-up for the alarm at %s' % time.strftime('%a %H:%M', time.localtime(nxt[0])))
    except OSError as e:
        log('RTC wakealarm: %s' % e)


def alarm_busy():
    """An alarm rings now or in a moment: stay awake until its ring time is over."""
    at = state.get('alarm_at', 0)
    return bool(at) and at - 2 * ALARM_EARLY_S <= time.time() <= at + state.get('alarm_ring_s', 300) + 30


def start_clocks():
    """gnome-clocks rings only while it runs (D-Bus service, started by activation)."""
    try:
        sync_call(session, 'org.gnome.clocks', '/org/gnome/clocks', 'org.freedesktop.DBus.Peer', 'Ping')
    except GLib.Error as e:
        log('gnome-clocks: %s' % e.message)


def alarm_ring(at, ring_s):
    """The alarm of gnome-clocks rings now: Phosh does not switch the display on for it (2026-11-14: the alarm rang with a
    dark screen, also when the phone was awake), so it is done here; the idle inhibitor keeps Phosh from blanking it at once."""
    state['alarm_timer'] = 0
    state['alarm_at'], state['alarm_ring_s'] = at, ring_s
    start_clocks()
    end_panel_dark()
    if state['dark']:
        end_dark('alarm')
    set_power_save(False)
    try:
        cookie = sync_call(session, 'org.gnome.SessionManager', '/org/gnome/SessionManager', 'org.gnome.SessionManager',
                           'Inhibit', ('m52xq-idle-suspend', 0, 'alarm is ringing', 8), '(susu)').unpack()[0]
        GLib.timeout_add_seconds(ring_s + 30, alarm_over, cookie)
    except GLib.Error as e:
        log('inhibit idle: %s' % e.message)
    log('alarm %s rings: display on' % time.strftime('%H:%M', time.localtime(at)))
    GLib.timeout_add_seconds(2, lambda: (set_power_save(False), False)[1])    # once more after the window of gnome-clocks
    GLib.timeout_add_seconds(2, schedule_alarm_timer)
    return False


def alarm_over(cookie):
    """m52xq r3 (2026-11-17): the ring time of the alarm is over. Before, only the idle inhibitor was dropped: the display
    that alarm_ring() had switched on stayed on (the idle watch had already fired during the ring, gsd/Phosh do not
    blank again) and the phone never slept until the user touched it (22:20 alarm, still awake and lit at 22:29).
    Nobody touched the phone: display off and suspend."""
    uninhibit(cookie)
    if state['idle']:
        log('alarm ring time over, nobody touched the phone: display off, suspending')
        set_power_save(True)
        schedule_recheck(3)
    return False


def uninhibit(cookie):
    try:
        sync_call(session, 'org.gnome.SessionManager', '/org/gnome/SessionManager', 'org.gnome.SessionManager',
                  'Uninhibit', (cookie,), '(u)')
    except GLib.Error:
        pass
    return False


def schedule_alarm_timer(*args):
    """Timer at the next alarm of gnome-clocks (monotonic: stopped during the sleep, so set again after every resume)."""
    if state.get('alarm_timer'):
        GLib.source_remove(state['alarm_timer'])
        state['alarm_timer'] = 0
    nxt = next_alarm()
    if nxt:
        delay_ms = int(max(0.2, nxt[0] - time.time()) * 1000)
        if delay_ms < 8 * 86400 * 1000:
            state['alarm_timer'] = GLib.timeout_add(delay_ms, alarm_ring, nxt[0], nxt[1] * 60)
    return False


PANEL_DARK_RESUME = '/sys/module/panel_samsung_s6e3hab_amb667an01/parameters/dark_resume'


def end_panel_dark():
    """The panel driver keeps the panel dark for some seconds after a wake-up that was not a key (system-sleep hook
    m52xq-dark-resume.sh); 0 switches the display on at once (the hook gives the parameter to the group video)."""
    try:
        with open(PANEL_DARK_RESUME, 'w') as f:
            f.write('0')
        log('panel dark resume ended')
    except OSError as e:
        log('panel dark resume: %s' % e)


def on_call_added(conn, sender, path, iface, name, params):
    """A new call (incoming or outgoing): the display must come on at once, not at the next check."""
    if name == 'CallAdded':
        call = params.unpack()[0]
    else:    # ObjectManager InterfacesAdded
        call, ifaces = params.unpack()
        if MM_CALL not in ifaces:
            return
    log('call %s added' % call)
    end_panel_dark()
    if state['dark']:
        end_dark('call')
    else:
        set_power_save(False)


def app_inhibits_idle():
    """m52xq r8 (2026-11-18): an application asked the session not to go idle (GtkApplication inhibit IDLE = 8):
    Snapshot does while the camera is open; the phone slept in the middle of a 4K recording at 01:40 and the file
    was lost (no moov). Returns the app ids / reasons, or '' when nobody inhibits."""
    try:
        if not sync_call(session, 'org.gnome.SessionManager', '/org/gnome/SessionManager', 'org.gnome.SessionManager',
                         'IsInhibited', (8,), '(u)').unpack()[0]:
            return ''
        who = []
        for path in sync_call(session, 'org.gnome.SessionManager', '/org/gnome/SessionManager',
                              'org.gnome.SessionManager', 'GetInhibitors').unpack()[0]:
            try:
                app = sync_call(session, 'org.gnome.SessionManager', path, 'org.gnome.SessionManager.Inhibitor',
                                'GetAppId').unpack()[0]
                why = sync_call(session, 'org.gnome.SessionManager', path, 'org.gnome.SessionManager.Inhibitor',
                                'GetReason').unpack()[0]
                if app == 'm52xq-idle-suspend':
                    continue
                who.append('%s: %s' % (app, why))
            except GLib.Error:
                pass
        return ', '.join(who) or 'an application'
    except GLib.Error as e:
        log('IsInhibited: %s' % e.message)
        return ''


def media_playing():
    try:
        names = sync_call(session, 'org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'ListNames'
                          ).unpack()[0]
    except GLib.Error:
        return False
    for n in names:
        if n.startswith('org.mpris.MediaPlayer2.'):
            try:
                if get_prop(session, n, '/org/mpris/MediaPlayer2', 'org.mpris.MediaPlayer2.Player', 'PlaybackStatus') == 'Playing':
                    return True
            except GLib.Error:
                pass
    return False


USER_WAKE_IRQ_NAMES = ('pwrkey', 'resin', 'synaptics', 'Volume', 'gpio-keys')


def wakeup_irq_name():
    """Name of the interrupt that ended the last sleep ('' when /sys/power/pm_wakeup_irq is empty, e.g. the modem)."""
    try:
        irq = open('/sys/power/pm_wakeup_irq').read().strip()
    except OSError:
        return ''
    if not irq:
        return ''
    for line in open('/proc/interrupts'):
        if line.split(':')[0].strip() == irq:
            return line.split()[-1]
    return irq


def woke_by_user():
    """The last wake-up IRQ (/sys/power/pm_wakeup_irq) belongs to a key or the touchscreen."""
    try:
        irq = open('/sys/power/pm_wakeup_irq').read().strip()
    except OSError:
        return False
    if not irq:
        return False
    for line in open('/proc/interrupts'):
        if line.split(':')[0].strip() == irq:
            return any(n in line for n in USER_WAKE_IRQ_NAMES)
    return False


def set_power_save(off):
    """Display off (PowerSaveMode 1) / on (0) through phoc (org.gnome.Mutter.DisplayConfig)."""
    try:
        sync_call(session, 'org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig', 'org.freedesktop.DBus.Properties',
                  'Set', ('org.gnome.Mutter.DisplayConfig', 'PowerSaveMode', GLib.Variant('i', 1 if off else 0)), '(ssv)')
    except GLib.Error as e:
        log('PowerSaveMode: %s' % e.message)


def dark_tick():
    """Keep the display off after a wake-up without the user until the user shows up, a call arrives or the phone sleeps."""
    if not state['dark']:
        state['dark_id'] = 0
        return False
    if call_busy():
        end_dark('call')
        return False
    if screen_on():
        # m52xq (2026-11-16): somebody switched the display on again during a dark wake-up. The 0.5 s ticks then fought
        # with it for 80 s (~300 blinks, lock screen flashing) until the power key. 3 times in 3 s = a fight: stop it,
        # switch the display off once and suspend at once.
        now = time.monotonic()
        state['dark_ons'] = [t for t in state['dark_ons'] if now - t < 3.0] + [now]
        if len(state['dark_ons']) == 1:
            dark_monitor_start()
        if len(state['dark_ons']) >= 3:
            log('dark wake-up: the display was switched on again %d times in 3 s by somebody else (fight), suspending now'
                % len(state['dark_ons']))
            state['dark_ons'] = []
            state['dark_id'] = 0
            set_power_save(True)
            GLib.timeout_add(300, lambda: (try_suspend('dark fight'), False)[1])
            return False
        set_power_save(True)
    return True


def dark_monitor_start():
    """m52xq (2026-11-16): record for 30 s who switches the display on during a dark wake-up (D-Bus calls to
    PowerSaveMode / DisplayConfig) into $XDG_RUNTIME_DIR/m52xq-dark-fight-dbus.log."""
    if state['dark_mon'] and state['dark_mon'].poll() is None:
        return
    path = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid()), 'm52xq-dark-fight-dbus.log')
    try:
        out = open(path, 'a')
        out.write('=== %s dark wake-up: display on again\n' % time.strftime('%F %T'))
        out.flush()
        state['dark_mon'] = subprocess.Popen(
            ['timeout', '30', 'dbus-monitor', '--session',
             "type='method_call',path='/org/gnome/Mutter/DisplayConfig'",
             "type='method_call',interface='org.gnome.ScreenSaver'",
             "type='signal',interface='org.gnome.ScreenSaver'"],
            stdout=out, stderr=subprocess.STDOUT)
        log('dark wake-up: display on again, recording D-Bus to %s' % path)
    except Exception as e:
        log('dark monitor: %s' % e)


def bt_restore():
    """Bluetooth (system-sleep/m52xq-ufs.sh), the modem network modes (m52xq-modem-2g.sh) and the GPS (m52xq-gps-sleep.sh) stay
    reduced over dark wake-ups (an unblocked Bluetooth chip wakes the next sleep at once, IRQ 158); give them back now that the
    user is here: m52xq-bt-restore.service -> /usr/local/sbin/m52xq-wake-restore (root unit, polkit rule 50-m52xq-sim-mode)."""
    if any(os.path.exists(f) for f in ('/run/m52xq-bt-was-on', '/run/m52xq-modem-2g-active', '/run/m52xq-gps-paused')):
        try:
            subprocess.Popen(['systemctl', 'start', '--no-block', 'm52xq-bt-restore.service'])
        except OSError as e:
            log('bt restore: %s' % e)


def telegram_playing():
    try:
        out = subprocess.run(['pactl', 'list', 'sink-inputs'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return 'application.name = "Telegram' in out


def telegram_running():
    for comm in glob.glob('/proc/[0-9]*/comm'):
        try:
            if open(comm).read().strip() == 'Telegram':
                return True
        except OSError:
            pass
    return False


def on_notify_main(app_name, summary):
    """A message of Telegram: the user chose (2026-11-14, variant B) sound only, the display stays dark; the dark wake-up
    gets another TELEGRAM_GRACE_S so the sound plays out and more messages can come, then the phone sleeps again."""
    if state['dark']:
        schedule_recheck(TELEGRAM_GRACE_S)
    log('notification of %s: display stays dark' % app_name)
    return False


def telegram_ring_main(idx):
    """Telegram Desktop plays the ringtone of an incoming call itself and sends no notification for it (pm-Plasma
    m52xq-call-screen-wake, 30.10): a new sound stream of Telegram = a call -> display on, stay awake.
    Only while nobody uses the phone (dark wake-up or display off): the stream of an ANSWERED call made the main window of
    Telegram come to the front and hide the call window (2026-11-14)."""
    if not state['dark'] and screen_on():
        log('Telegram sound stream #%s: the phone is in use, left alone' % idx)
        return False
    if state['dark']:
        end_dark('Telegram sound stream #%s (call)' % idx)
    else:
        set_power_save(False)
    end_panel_dark()
    log('Telegram sound stream #%s: display on (call)' % idx)
    # m52xq r6 (2026-11-17): no org.freedesktop.Application.Activate here any more. It raised the MAIN window of Telegram over
    # its separate incoming-call window: after unlocking only the chat list was there, no accept/decline (01:09). Telegram
    # maps the call window itself and Phosh puts a new window on top, so after unlocking the call window is in front.
    return False


def activate_telegram():
    try:
        sync_call(session, 'org.telegram.desktop', '/org/telegram/desktop', 'org.freedesktop.Application', 'Activate',
                  ({},), '(a{sv})')
        log('Telegram window activated')
    except GLib.Error as e:
        log('Telegram activate: %s' % e.message)
    return False


def check_sink_input(idx):
    try:
        out = subprocess.run(['pactl', 'list', 'sink-inputs'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    block, found = [], False
    for line in out.splitlines():
        if line.startswith('Sink Input #'):
            found = line.strip() == 'Sink Input #%s' % idx
            continue
        if found:
            block.append(line)
    if any('Telegram' in l and ('application.name' in l or 'application.process.binary' in l) for l in block):
        telegram_ring_main(idx)
    return False


def start_sound_watch():
    try:
        proc = subprocess.Popen(['pactl', 'subscribe'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as e:
        log('pactl subscribe: %s' % e)
        return
    state['pactl'] = proc
    ch = GLib.IOChannel.unix_new(proc.stdout.fileno())
    GLib.io_add_watch(ch, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                      lambda c, cond: on_pactl_line_file(proc, cond))
    log('watching sound streams (Telegram calls)')


def on_pactl_line_file(proc, condition):
    """Raw reads (a buffered readline would keep further lines back until the next event)."""
    try:
        data = os.read(proc.stdout.fileno(), 4096).decode(errors='replace')
    except OSError:
        data = ''
    if not data:
        log('pactl subscribe ended')
        return False
    state['pactl_buf'] = state.get('pactl_buf', '') + data
    *lines, state['pactl_buf'] = state['pactl_buf'].split('\n')
    for line in lines:
        if "'new' on sink-input #" in line:
            idx = line.strip().rsplit('#', 1)[-1]
            GLib.timeout_add(300, check_sink_input, idx)
    return True


def notify_filter(conn, message, incoming):
    """Session bus monitor (worker thread of GDBus): Notify calls; the work is done in the main loop."""
    # only the monitored Notify calls are swallowed (GDBus must not answer them on a monitor connection); everything else,
    # e.g. the reply to BecomeMonitor, goes on
    try:
        if message.get_member() != 'Notify' or message.get_interface() != 'org.freedesktop.Notifications':
            return message
        body = message.get_body()
        if body is not None and body.n_children() >= 4:
            app = body.get_child_value(0).get_string()
            summary = body.get_child_value(3).get_string()
            if 'telegram' in app.lower():
                GLib.idle_add(on_notify_main, app, summary)
    except Exception:
        pass
    return None


def start_notify_monitor():
    try:
        addr = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
        mon = Gio.DBusConnection.new_for_address_sync(
            addr, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
        mon.add_filter(notify_filter)
        mon.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.Monitoring', 'BecomeMonitor',
                      GLib.Variant('(asu)', (["type='method_call',interface='org.freedesktop.Notifications',member='Notify'"], 0)),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
        state['notify_monitor'] = mon
        log('watching notifications (Telegram)')
    except GLib.Error as e:
        log('notification monitor: %s' % e.message)


def end_dark(why):
    if state['dark_id']:
        GLib.source_remove(state['dark_id'])
        state['dark_id'] = 0
    if state['dark']:
        state['dark'] = False
        set_power_save(False)
        log('dark wake-up ends (%s): display back on' % why)
        bt_restore()


def screen_on():
    """The display is on (DPMS "On"): somebody is looking at the phone."""
    import glob
    for f in glob.glob('/sys/class/drm/*DSI*/dpms'):
        try:
            if open(f).read().strip().lower() == 'on':
                return True
        except OSError:
            pass
    return False


def try_suspend(reason):
    state['recheck_id'] = 0
    if not state['idle'] or state['timeout_s'] <= 0:
        return False
    # after a wake-up without input the display must be off, otherwise somebody woke the phone with the power key
    if reason not in ('idle', 'dark fight') and screen_on():
        # m52xq r3: look again later (before, nothing was scheduled: after an alarm the phone stayed awake for good;
        # a touch of the user clears state['idle'] and ends this)
        log('display is on after the wake-up, not suspending, looking again in 60 s')
        schedule_recheck(60)
        return False
    voip = os.path.exists(os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid()), 'm52xq-voip-active'))
    # 2026-11-14: the idle timeout came in the same second as the ringtone of a Telegram call (the flag of m52xq-voip-audio
    # is updated once a second) and the phone went to sleep during the ringing: look at the sound streams directly too
    voip = voip or telegram_playing()
    for why, busy in (('charger', not on_battery()), ('call', call_busy()), ('media playing', media_playing()),
                      ('alarm', alarm_busy()), ('Telegram call', voip),
                      ('inhibited by %s' % (app_inhibits_idle() or '-'), bool(app_inhibits_idle()))):
        if busy:
            log('not suspending (%s), looking again in 60 s' % why)
            schedule_recheck(60)
            return False
    log('suspending (%s)' % reason)
    # the display is switched off BEFORE the sleep: after the resume phoc then finds it off and does not flash it
    # (a wake-up by a key / the touchscreen / a call puts PowerSaveMode back to 0 in on_prepare_for_sleep)
    set_power_save(True)
    set_rtc_alarm()
    if state.get('alarm_at') and state['alarm_at'] - time.time() < 3600:
        start_clocks()
    try:
        sync_call(system, 'org.freedesktop.login1', '/org/freedesktop/login1', 'org.freedesktop.login1.Manager', 'Suspend',
                  (False,), '(b)', 20000)
    except GLib.Error as e:
        log('suspend refused: %s; looking again in 120 s' % e.message)
        schedule_recheck(120)
    return False


def schedule_recheck(seconds):
    if state['recheck_id']:
        GLib.source_remove(state['recheck_id'])
    state['recheck_id'] = GLib.timeout_add_seconds(seconds, try_suspend, 'recheck')


def on_watch_fired(conn, sender, path, iface, name, params):
    wid = params.unpack()[0]
    if wid == state['watch_idle']:
        state['idle'] = True
        log('idle for %d s' % state['timeout_s'])
        add_active_watch()
        try_suspend('idle')
    elif wid == state['watch_active']:
        # the watch of the user's activity fires once: it is registered again when the idle watch fires
        state['watch_active'] = None
        state['idle'] = False
        state['active_since_resume'] = True
        end_dark('user is active')
        if state['recheck_id']:
            GLib.source_remove(state['recheck_id'])
            state['recheck_id'] = 0
        log('user is active')


def arm():
    """(Re)register the watches with the current setting."""
    t = timeout_s()
    if t != state['timeout_s'] or state['watch_idle'] is None:
        for key in ('watch_idle', 'watch_active'):
            if state[key] is not None:
                try:
                    sync_call(session, IDLE_BUS, IDLE_PATH, IDLE_IFACE, 'RemoveWatch', (state[key],), '(u)')
                except GLib.Error:
                    pass
                state[key] = None
        state['timeout_s'] = t
        if t > 0:
            state['watch_idle'] = sync_call(session, IDLE_BUS, IDLE_PATH, IDLE_IFACE, 'AddIdleWatch', (t * 1000,), '(t)').unpack()[0]
            log('idle watch %d: %d s on battery' % (state['watch_idle'], t))
        else:
            log('automatic suspend is off in the settings')


def add_active_watch():
    if state['watch_active'] is not None:
        try:
            sync_call(session, IDLE_BUS, IDLE_PATH, IDLE_IFACE, 'RemoveWatch', (state['watch_active'],), '(u)')
        except GLib.Error:
            pass
    state['watch_active'] = sync_call(session, IDLE_BUS, IDLE_PATH, IDLE_IFACE, 'AddUserActiveWatch', None).unpack()[0]


def irq_snapshot():
    """{irq: (sum of the counts of all CPUs, 'chip hwirq type name')} from /proc/interrupts"""
    snap = {}
    try:
        for line in open('/proc/interrupts'):
            tok = line.split()
            if not tok or not tok[0].endswith(':') or not tok[0][:-1].isdigit():
                continue
            n = 0
            while n + 1 < len(tok) and tok[n + 1].isdigit():
                n += 1
            snap[tok[0][:-1]] = (sum(int(x) for x in tok[1:n + 1]), ' '.join(tok[n + 1:]))
    except OSError:
        pass
    return snap


def wakeup_snapshot():
    snap = {}
    import glob
    for d in glob.glob('/sys/class/wakeup/wakeup*'):
        try:
            snap[open(d + '/name').read().strip()] = int(open(d + '/event_count').read())
        except OSError:
            pass
    return snap


def take_sleep_delay():
    """m52xq r7 (2026-11-17): a logind 'delay' inhibitor, released 2 s after PrepareForSleep(true). Telegram Desktop drops its
    server connection on the sleep signal and reconnects; when the phone fell asleep first, it had no connection during the
    sleep and calls never woke it (02:29-02:31: 3 calls lost). 2 s are enough for the reconnect (0.2-0.7 s seen)."""
    if state.get('delay_fd') is not None:
        return
    try:
        res, fds = system.call_with_unix_fd_list_sync(
            'org.freedesktop.login1', '/org/freedesktop/login1', 'org.freedesktop.login1.Manager', 'Inhibit',
            GLib.Variant('(ssss)', ('sleep', 'm52xq-idle-suspend', 'let Telegram reconnect before the sleep', 'delay')),
            GLib.VariantType('(h)'), Gio.DBusCallFlags.NONE, 5000, None, None)
        state['delay_fd'] = fds.get(res.unpack()[0])
    except GLib.Error as e:
        log('sleep delay inhibitor: %s' % e.message)


def release_sleep_delay():
    fd = state.get('delay_fd')
    state['delay_fd'] = None
    if fd is not None:
        try:
            os.close(fd)
        except OSError:
            pass
    return False


def on_prepare_for_sleep(conn, sender, path, iface, name, params):
    going = params.unpack()[0]
    if not going:
        take_sleep_delay()    # r7: for the next sleep
    if going:
        GLib.timeout_add(2000, release_sleep_delay)    # r7
        state['irq_before'] = irq_snapshot()
        state['ws_before'] = wakeup_snapshot()
        state['sleep_at'] = time.time()
        if state['dark_id']:
            GLib.source_remove(state['dark_id'])
            state['dark_id'] = 0
        state['dark'] = False
        log('going to sleep')
        return
    # what woke the phone: the interrupts and wakeup sources that counted during the sleep
    before, after = state.get('irq_before', {}), irq_snapshot()
    diff = sorted(((after[i][0] - before.get(i, (0, ''))[0], i, after[i][1]) for i in after
                   if after[i][0] - before.get(i, (0, ''))[0] > 0), reverse=True)
    wb, wa = state.get('ws_before', {}), wakeup_snapshot()
    wdiff = ['%s +%d' % (k, wa[k] - wb.get(k, 0)) for k in wa if wa[k] - wb.get(k, 0) > 0]
    log('slept %d s; IRQs during the sleep: %s; wakeup sources: %s' % (
        time.time() - state.get('sleep_at', time.time()),
        ', '.join('%s %s +%d' % (i, nm[-34:], d) for d, i, nm in diff[:7]) or '-', ', '.join(wdiff) or '-'))
    slept = time.time() - state.get('sleep_at', time.time())
    state['resumed_at'] = time.time()
    schedule_alarm_timer()
    state['active_since_resume'] = False
    # 2026-11-14: a 45 s window after EVERY Wi-Fi wake-up became a loop (Telegram pings while awake, the answers of the server
    # wake the phone again 1-14 s after it fell asleep: 11 sleeps of 1-14 s in 9 min, ~5 %/h). The long window is only given
    # after a real sleep (>= TELEGRAM_MIN_SLEEP_S); a notification of Telegram in a short window still extends it.
    # only a Wi-Fi wake-up (irq ce2) can bring something for Telegram; the regular 90 s wake-ups of the modem (pm_wakeup_irq
    # empty) got the 45 s window for nothing (2026-11-14: 90 s sleep -> 45 s awake -> ...)
    wake = wakeup_irq_name()
    grace = TELEGRAM_GRACE_S if (telegram_running() and slept >= TELEGRAM_MIN_SLEEP_S and wake == 'ce2') else RESUME_GRACE_S
    log('resumed (woken by %s); looking again in %d s if nobody touched the phone' % (wake or '-', grace))
    # woke up without user input (modem, alarm, USB): suspend again, a user input cancels this (active watch)
    state['idle'] = True
    add_active_watch()
    schedule_recheck(grace)
    if alarm_busy():
        # woke up for an alarm of gnome-clocks: display on, no dark window, stay awake while it rings
        start_clocks()
        # m52xq r5 (2026-11-17): the RTC wakes the phone ALARM_EARLY_S before the alarm (gnome-clocks must run); the
        # display stayed on from then on, 15 s before the ring. Keep it (and the panel) dark: alarm_ring() switches it
        # on at the ring time.
        set_power_save(True)
        log('woke up for the alarm: display dark until it rings, awake until the ring time is over')
        schedule_recheck(int(state['alarm_at'] + state.get('alarm_ring_s', 300) + 40 - time.time()))
    elif woke_by_user() or call_busy():
        if not woke_by_user():
            end_panel_dark()    # a call: no dark window of the panel driver
        set_power_save(False)    # PowerSaveMode may still be 1 from an earlier dark wake-up
        log('woke up by the user or a call: display stays on')
    else:
        state['dark'] = True
        state['dark_ons'] = []
        set_power_save(True)
        log('dark wake-up: display off')
        state['dark_id'] = GLib.timeout_add(int(DARK_S * 1000), dark_tick)


def main():
    session.signal_subscribe(IDLE_BUS, IDLE_IFACE, 'WatchFired', IDLE_PATH, None, Gio.DBusSignalFlags.NONE, on_watch_fired)
    system.signal_subscribe('org.freedesktop.login1', 'org.freedesktop.login1.Manager', 'PrepareForSleep',
                            '/org/freedesktop/login1', None, Gio.DBusSignalFlags.NONE, on_prepare_for_sleep)
    system.signal_subscribe(MM_BUS, MM_VOICE, 'CallAdded', None, None, Gio.DBusSignalFlags.NONE, on_call_added)
    system.signal_subscribe(MM_BUS, 'org.freedesktop.DBus.ObjectManager', 'InterfacesAdded', '/org/freedesktop/ModemManager1',
                            None, Gio.DBusSignalFlags.NONE, on_call_added)
    settings.connect('changed', lambda *a: arm())
    try:
        state['clocks_settings'] = Gio.Settings.new('org.gnome.clocks')
        state['clocks_settings'].connect('changed::alarms', schedule_alarm_timer)
    except Exception as e:
        log('gnome-clocks settings: %s' % e)
    state['idle'] = False
    take_sleep_delay()    # r7
    arm()
    schedule_alarm_timer()
    start_notify_monitor()
    start_sound_watch()
    log('started: on battery %s, idle time %d s' % (on_battery(), state['timeout_s']))
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
