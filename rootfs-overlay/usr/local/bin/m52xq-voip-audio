#!/bin/sh
# pmOS Phosh copy of 003 в7 (9b6d91dd) without the Lomiri display call (com.canonical.Unity.Screen)
# M52XQ: while a VoIP call (Telegram) is playing, its sound goes to the earpiece (the speaker you hold to your ear);
# after the call everything returns to the loud speaker. A plugged USB headset is left alone (PulseAudio uses it by itself),
# and a route chosen by hand (quick setting "Sound output") during the call is respected until the call ends.
export PULSE_SERVER=unix:/run/user/10000/pulse/native PULSE_COOKIE=/home/user/.config/pulse/cookie
ROUTE=/usr/local/bin/m52xq-audio-route
auto=0		# 1 while we switched to the earpiece ourselves
manual=0	# 1 after the user changed the route during a call
active=0	# consecutive seconds with a VoIP stream AND its microphone (= the call is answered)
nomic=0		# consecutive seconds without the microphone of Telegram (31.10: the call is over / still ringing)
idle=0
prev_si=0	# 003 в7: Telegram playback stream in the previous second
prev_usb=''	# r2: USB headset sink seen in the previous second
# r4 (2026-11-17): remember what this script set; a change by someone else (the Speakerphone icon) during a call is a manual choice
ours=''; prev_r=''
setr() { $ROUTE "$1" >/dev/null && ours=$1; }
prev_bt=''	# r3: Bluetooth headphones sink seen in the previous second
# 31.10: a script (re)started while the earpiece is selected and no call is running must not leave the earpiece behind
if [ "$($ROUTE status 2>/dev/null)" = earpiece ] && ! pactl list source-outputs 2>/dev/null | grep -qE 'application.name = "(Telegram|Telegram Desktop)"'; then
	$ROUTE speaker >/dev/null
fi
while :; do
	sleep 1
	si=0; so=0
	pactl list sink-inputs 2>/dev/null | grep -qE 'application.name = "(Telegram|Telegram Desktop)"' && si=1
	pactl list source-outputs 2>/dev/null | grep -qE 'application.name = "(Telegram|Telegram Desktop)"' && so=1
	# pmOS Phosh (2026-11-14): the display for a ringing Telegram call is switched on by m52xq-idle-suspend (sound stream watch)
	prev_si=$si
	# 003 в7: tells m52xq-powerkey that Telegram rings / talks (no suspend, no screen off by Lomiri's notification timeout)
	if [ "$si" = 1 ]; then touch /run/user/10000/m52xq-voip-active; else rm -f /run/user/10000/m52xq-voip-active; fi
	# a call counts as active only when Telegram plays AND records: while the phone is still ringing the microphone is closed, and
	# the ringtone must stay on the loud speaker (31.10: it moved to the earpiece 2 s after the ringing began)
	if [ "$si" = 1 ] && [ "$so" = 1 ]; then
		active=$((active + 1)); nomic=0; idle=0
	else
		active=0; nomic=$((nomic + 1))
		if [ "$si" = 1 ]; then idle=0; else idle=$((idle + 1)); fi
	fi
	r=$($ROUTE status 2>/dev/null)
	# m52xq r4: the output was changed by someone else since the last second (not by us) during a call -> manual, keep it.
	# Before: call on the headset, icon -> earpiece -> loud speaker, and this script took the loud speaker back to the earpiece
	# 1 s later (it took it for the start of a call on the loud speaker, 01:54:41/42).
	if [ "$si" = 1 ] && [ "$so" = 1 ] && [ -n "$prev_r" ] && [ "$r" != "$prev_r" ] && [ "$r" != "$ours" ]; then
		manual=1; auto=0
	fi
	# m52xq r2 (2026-11-17): a USB headset plugged in (also during a call) takes the sound at once; PulseAudio did not switch the
	# output by itself after m52xq-audio-route had set the built-in card as default (the microphone went to the headset, the sound
	# stayed in the earpiece). Unplugged: back to the earpiece during a call, else to the loud speaker.
	usb=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^alsa_output\.usb-/ {print $2; exit}')
	if [ -n "$usb" ] && [ -z "$prev_usb" ]; then
		[ "$r" != usb ] && setr usb
		r=usb; auto=0; manual=1
	elif [ -z "$usb" ] && [ -n "$prev_usb" ]; then
		if [ "$si" = 1 ] && [ "$so" = 1 ]; then setr earpiece && auto=1; manual=0; else setr speaker; auto=0; manual=0; fi
		r=$($ROUTE status 2>/dev/null)
	fi
	prev_usb=$usb
	# m52xq r3: Bluetooth headphones the same way (connected -> their sound; gone -> earpiece in a call, else loud speaker)
	bt=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_(sink|output)\./ {print $2; exit}')
	if [ -n "$bt" ] && [ -z "$prev_bt" ] && [ -z "$usb" ]; then
		[ "$r" != bt ] && setr bt
		r=bt; auto=0; manual=1
	elif [ -z "$bt" ] && [ -n "$prev_bt" ] && [ -z "$usb" ]; then
		if [ "$si" = 1 ] && [ "$so" = 1 ]; then setr earpiece && auto=1; manual=0; else setr speaker; auto=0; manual=0; fi
		r=$($ROUTE status 2>/dev/null)
	fi
	prev_bt=$bt
	if [ "$active" -ge 2 ] && [ "$auto" = 0 ] && [ "$manual" = 0 ] && [ "$r" = speaker ]; then
		setr earpiece && auto=1
	elif [ "$auto" = 1 ] && [ "$r" != earpiece ]; then
		manual=1; auto=0		# the user moved the sound elsewhere during the call
	elif [ "$auto" = 1 ] && [ "$nomic" -ge 3 ]; then
		# the microphone closed: the conversation is over; Telegram keeps its playback stream for 15-30 s, but the next ring
		# must already come from the loud speaker (31.10: it stayed on the earpiece)
		setr speaker; auto=0
	elif [ "$idle" -ge 5 ]; then
		# m52xq r5 (2026-11-17): once, 5 s after Telegram stopped playing: a choice made during the call (loud speaker by the icon)
		# does not stay — back to the plugged USB headset / Bluetooth headphones (the next ringtone went to the loud speaker, 02:06)
		if [ "$idle" -eq 5 ]; then
			if [ -n "$usb" ] && [ "$r" != usb ]; then setr usb
			elif [ -n "$bt" ] && [ -z "$usb" ] && [ "$r" != bt ]; then setr bt
			fi
		fi
		auto=0; manual=0
	fi
	prev_r=$($ROUTE status 2>/dev/null); ours=''
done
