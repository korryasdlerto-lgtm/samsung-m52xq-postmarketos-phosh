#!/usr/bin/env python3
# M52XQ (Phosh): reboot menu — reboot, reboot into TWRP, power off, cancel (GTK4/libadwaita, as the pmOS-Lomiri power menu).
# TWRP: the Samsung bootloader boots recovery when restart_reason holds 0x77665502 after a warm reset; the kernel does that
# for "reboot recovery" (syscon-reboot-mode + reboot=warm), the reboot argument is passed through logind SetRebootParameter
# (allowed for the active session). Window title in English, buttons in the session language.
import os
import subprocess

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gtk

RU = os.environ.get('LANG', '').startswith('ru')
L = {
    'reboot': ('Перезагрузка', 'Reboot'),
    'twrp': ('Перезагрузка в рекавери', 'Reboot into recovery'),
    'off': ('Выключение', 'Power off'),
    'cancel': ('Отмена', 'Cancel'),
}


def tr(k):
    return L[k][0 if RU else 1]


def act(what):
    if what == 'twrp':
        r = subprocess.run(['busctl', 'call', 'org.freedesktop.login1', '/org/freedesktop/login1',
                            'org.freedesktop.login1.Manager', 'SetRebootParameter', 's', 'recovery'])
        if r.returncode != 0:
            return
        subprocess.run(['systemctl', 'reboot'])
    elif what == 'reboot':
        subprocess.run(['systemctl', 'reboot'])
    elif what == 'off':
        subprocess.run(['systemctl', 'poweroff'])


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id='org.m52xq.RebootMenu')

    def do_activate(self):
        w = Adw.ApplicationWindow(application=self, title='Reboot menu', default_width=420, default_height=520)
        # portrait: one column; landscape (window wider than 560sp): 2x2 grid; the content scrolls if it still does not fit
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, row_spacing=14, column_spacing=14,
                           min_children_per_line=1, max_children_per_line=1, valign=Gtk.Align.CENTER)
        for key, style in (('reboot', 'suggested-action'), ('twrp', None), ('off', 'destructive-action'), ('cancel', None)):
            b = Gtk.Button(label=tr(key), height_request=64)
            b.add_css_class('pill')
            if style:
                b.add_css_class(style)
            b.connect('clicked', self.on_click, key, w)
            flow.append(b)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        box = Gtk.Box(margin_start=24, margin_end=24, margin_top=16, margin_bottom=16, valign=Gtk.Align.CENTER)
        box.append(flow)
        flow.set_hexpand(True)
        sc.set_child(box)
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse('min-width: 560sp'))
        bp.add_setter(flow, 'max-children-per-line', 2)
        w.add_breakpoint(bp)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        tv.set_content(sc)
        w.set_content(tv)
        w.present()

    def on_click(self, _b, key, w):
        if key == 'cancel':
            w.close()
            return
        act(key)


if __name__ == '__main__':
    App().run(None)
