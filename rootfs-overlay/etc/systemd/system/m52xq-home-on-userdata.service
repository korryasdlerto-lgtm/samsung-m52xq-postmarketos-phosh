[Unit]
Description=M52XQ: /home on the userdata partition
DefaultDependencies=no
RequiresMountsFor=/mnt/userdata
After=local-fs.target mnt-userdata.mount
Before=systemd-user-sessions.service greetd.service display-manager.service user@10000.service
ConditionPathExists=/dev/disk/by-partlabel/userdata

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/m52xq-home-on-userdata

[Install]
WantedBy=multi-user.target
