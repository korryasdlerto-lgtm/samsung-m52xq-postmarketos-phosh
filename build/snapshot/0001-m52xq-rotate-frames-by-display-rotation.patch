+                        glib::clone!(
+                            #[weak]
+                            obj,
+                            #[upgrade_or_default]
+                            move |args| {
+                                if args.get(2).and_then(|v| v.get::<String>().ok()).as_deref()
+                                    == Some("MonitorsChanged")
+                                {
+                                    obj.m52xq_update_transform();
+                                }
+                                None
+                            }
+                        ),
+                    );
+                    obj.imp().m52xq_display_proxy.replace(Some(proxy));
+                    obj.m52xq_update_transform();
+                }
+            ),
+        );
+    }
+
+    fn m52xq_update_transform(&self) {
+        let Some(proxy) = self.imp().m52xq_display_proxy.borrow().clone() else {
+            return;
+        };
+        proxy.call(
+            "GetCurrentState",
+            None,
+            gio::DBusCallFlags::NONE,
+            -1,
+            None::<&gio::Cancellable>,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move |res| {
+                    let Ok(state) = res else {
+                        return;
+                    };
+                    // (serial, monitors, logical_monitors a(iiduba(ssss)a{sv}), properties)
+                    let logical = state.child_value(2);
+                    if logical.n_children() == 0 {
+                        return;
+                    }
+                    let transform = logical.child_value(0).child_value(3).get::<u32>().unwrap_or(0) & 3;
+                    obj.imp().m52xq_display_transform.set(transform);
+                    // turn the camera frames back by the display rotation; M52XQ_SNAPSHOT_FLIP_DIR=1 swaps the
+                    // 90 degree directions (for testing on other devices)
+                    let invert = std::env::var("M52XQ_SNAPSHOT_FLIP_DIR").as_deref() == Ok("1");
+                    // checked on the M52 (2026-11-12): display transform 3 (landscape) needs 90l
+                    // m52xq (2026-11-13): the front camera (imx616, rotation 90) came out upside down while the back
+                    // ones (rotation 270) are upright -> turn the front frames by another 180 degrees;
+                    // M52XQ_SNAPSHOT_FRONT_180=0 switches this off
+                    let front = obj.imp().is_front_camera.get();
+                    // extra quarter turns of the front frames: M52XQ_SNAPSHOT_FRONT_STEPS=0..3 (default 2 = 180),
+                    // M52XQ_SNAPSHOT_FRONT_180=0 is the old switch for 0
+                    // m52xq (2026-11-16, checked on the M52): the front camera faces the user, so its frames turn the
+                    // other way round than the back ones (landscape: back 90l, front 90r), portrait needs no extra turn.
+                    // M52XQ_SNAPSHOT_FRONT_STEPS=0..3 adds quarter turns on top (default 0) for testing.
+                    let front_steps: u32 = std::env::var("M52XQ_SNAPSHOT_FRONT_STEPS")
+                        .ok()
+                        .and_then(|s| s.parse().ok())
+                        .unwrap_or(0);
+                    let base: u32 = match (transform, invert) {
+                        (1, false) | (3, true) => 1,
+                        (1, true) | (3, false) => 3,
+                        (2, _) => 2,
+                        _ => 0,
+                    };
+                    let steps = if front { (4 - base) % 4 + front_steps } else { base };
+                    let direction = match steps % 4 {
+                        1 => "90r",
+                        2 => "180",
+                        3 => "90l",
+                        _ => "identity",
+                    };
+                    log::info!("m52xq: display transform {transform}, front {front}, video-direction {direction}");
+                    /*
+                     * m52xq r104: the Venus encoder (v4l2h264enc) crashes its firmware on portrait-shaped frames
+                     * (1080x1920: Err_Fatal, "recovery failed to init HFI", only a reboot helps; 2026-11-17 and
+                     * pmOS Plasma 2026-10-22). A quarter turn of the RECORDING branch is therefore not done on the
+                     * frames: they stay landscape and the MP4 gets an orientation tag (players turn the video).
+                     */
+                    let video_flip = obj.imp().m52xq_video_flip.borrow().clone();
+                    /*
+                     * m52xq r107: the recorded frames are the raw sensor frames, not the viewfinder ones: checked on
+                     * the M52 (2026-11-17, frames pulled with ffmpeg -noautorotate) - main camera portrait (t = 0)
+                     * lies a quarter turn counter-clockwise, landscape (t = 3) is upright. The same formula as the
+                     * EXIF of the full-resolution photos: main 1 + t quarter turns clockwise, front 3 - t.
+                     */
+                    let t = transform as i32;
+                    let vsteps = if front { 3 - t } else { 1 + t }.rem_euclid(4);
+                    let video_direction = "identity";
+                    let orientation = match vsteps {
+                        1 => "rotate-90",
+                        2 => "rotate-180",
+                        3 => "rotate-270",
+                        _ => "rotate-0",
+                    };
+                    obj.imp().m52xq_video_orientation.set(orientation);
+                    for flip in obj.imp().m52xq_flips.borrow().iter() {
+                        if video_flip.as_ref() == Some(flip) {
+                            flip.set_property_from_str("video-direction", video_direction);
+                        } else {
+                            flip.set_property_from_str("video-direction", direction);
+                        }
+                    }
+                    // m52xq r108: the turned frame has other sides - crop the zoom for the new size at once
+                    if obj.imp().is_recording_video.borrow().is_none() {
+                        obj.m52xq_apply_crops();
+                    }
+                    log::info!("m52xq: recording frames {video_direction}, orientation tag {orientation}");
+                }
+            ),
+        );
+    }
+
+    fn m52xq_zoom(&self) -> f64 {
+        m52xq_zoom_value(&self.imp().m52xq_zoom)
+    }
+
+    fn m52xq_set_zoom(&self, zoom: f64) {
+        let zoom = zoom.clamp(1.0, 4.0);
+        self.imp()
+            .m52xq_zoom
+            .store(zoom.to_bits(), std::sync::atomic::Ordering::Relaxed);
+        self.queue_draw();
+    }
+
+    /// m52xq r110: the "4K Video" setting (Ubuntu Touch 003: 4K video size -> the viewfinder is 4K too, the source
+    /// cannot change its size on the fly)
+    pub fn m52xq_set_video_4k(&self, on: bool) {
+        self.imp().m52xq_video_4k.set(on);
+        self.m52xq_update_height();
+    }
+
+    /// m52xq r110: the camera page switched between the picture and the video mode
+    pub fn m52xq_set_video_mode(&self, on: bool) {
+        self.imp().m52xq_video_mode.set(on);
+        self.m52xq_update_height();
+    }
+
+    /// m52xq r110: 2160 in the video mode with the 4K setting, 1080 otherwise; a change re-applies the caps of the
+    /// camera and restarts a running stream through NULL (pipewiresrc negotiates the size only when it connects)
+    fn m52xq_update_height(&self) {
+        let imp = self.imp();
+        let want = if imp.m52xq_video_4k.get() && imp.m52xq_video_mode.get() { 2160 } else { 1080 };
+        let old = crate::utils::caps::M52XQ_WANTED_HEIGHT.swap(want, std::sync::atomic::Ordering::Relaxed);
+        if old == want || imp.is_recording_video.borrow().is_some() {
+            return;
+        }
+        log::info!("m52xq: viewfinder height {old} -> {want}");
+        /*
+         * m52xq r114: the 24 fps limit of 4K was set too late (on the CAPS event of the recording, the encoder had
+         * already negotiated 30/1): Venus got 4K30, lost timestamps (qtmux "Buffer has no PTS") and camerabin aborted
+         * (2026-11-17, r112/r113). Set it here, before the stream starts again in the new size.
+         */
+        if let Some(rate_caps) = imp.m52xq_rate_caps.get() {
+            let fps = if want >= 2160 { 24 } else { 30 };
+            rate_caps.set_property(
+                "caps",
+                gst::Caps::builder("video/x-raw")
+                    .field("framerate", gst::Fraction::new(fps, 1))
+                    .build(),
+            );
+            log::info!("m52xq: recording framerate {fps}");
+        }
+        let (Some(camera), Some(capsfilter)) = (self.camera(), imp.capsfilter.get()) else {
+            return;
+        };
+        let playing = imp.camerabin().current_state() == gst::State::Playing;
+        if playing {
+            self.stop_stream();
+        }
+        // m52xq r115: 4K from libcamerasrc directly (PipeWire stalled 4K: 300 ms gaps), the rest from PipeWire
+        let lc = want >= 2160 && std::env::var("M52XQ_4K_PIPEWIRE").as_deref() != Ok("1");
+        if !self.m52xq_swap_source(lc.then_some(&camera)) {
+            capsfilter.set_property("caps", camera.best_caps());
+        }
+        // m52xq r121: the encoding profile again, with the QP of the new size (4K: M52XQ_VENC_QP_4K)
+        self.setup_recording();
+        log::info!("m52xq: encoder QP {:?} for height {want}", m52xq_venc_qp());
+        if playing {
+            self.start_stream();
+        }
+    }
+
+    /// m52xq r115: the camera path for libcamerasrc ("/base/soc@0/cci@ac4a000/i2c-bus@0/camera@2d") from the
+    /// properties of the PipeWire camera (api.libcamera.path / object.path)
+    fn m52xq_libcamera_name(camera: &crate::Camera) -> Option<String> {
+        camera.properties().values().find_map(|value| {
+            let s = value.get::<String>().ok()?;
+            let i = s.find("/base/")?;
+            Some(s[i..].to_string())
+        })
+    }
+
+    /// m52xq r115: put libcamerasrc (Some(camera)) or the PipeWire source (None) in front of the capsfilter of
+    /// the camera bin; the pipeline must be in NULL. Returns true when libcamerasrc is in use afterwards.
+    fn m52xq_swap_source(&self, camera: Option<&crate::Camera>) -> bool {
+        let lc = self.m52xq_swap_source_inner(camera);
+        // m52xq r125: NV12 first only for libcamerasrc
+        self.imp()
+            .camerabin()
+            .set_property("video-capture-caps", m52xq_video_caps(lc));
+        lc
+    }
+
+    fn m52xq_swap_source_inner(&self, camera: Option<&crate::Camera>) -> bool {
+        let imp = self.imp();
+        let (Some(pw), Some(capsfilter)) = (imp.camera_element.get(), imp.capsfilter.get()) else {
+            return false;
+        };
+        let Some(bin) = capsfilter.parent().and_then(|p| p.downcast::<gst::Bin>().ok()) else {
+            return false;
+        };
+        let old_lc = imp.m52xq_lc_src.borrow_mut().take();
+        if let Some(lc) = &old_lc {
+            let _ = lc.set_state(gst::State::Null);
+            if let Some(tag) = imp.m52xq_lc_tag.borrow_mut().take() {
+                let _ = tag.set_state(gst::State::Null);
+                lc.unlink(&tag);
+                tag.unlink(capsfilter);
+                let _ = bin.remove(&tag);
+            } else {
+                lc.unlink(capsfilter);
+            }
+            let _ = bin.remove(lc);
+            if bin.add(pw).is_err() || pw.link(capsfilter).is_err() {
+                log::error!("m52xq: could not put the PipeWire source back");
+            }
+            log::info!("m52xq: camera source: PipeWire");
+            imp.m52xq_pw_retries.set(0);
+        }
+        let Some(camera) = camera else {
+            return false;
+        };
+        // m52xq r117: only cameras that have 3840x2160 (macro gc5035 is 2592x1944: libcamerasrc never negotiated)
+        let has_4k = camera.caps().is_some_and(|caps| {
+            caps.iter().any(|st| {
+                st.get::<i32>("width").is_ok_and(|w| w == 3840) && st.get::<i32>("height").is_ok_and(|h| h == 2160)
+            })
+        });
+        if !has_4k {
+            log::info!("m52xq: camera {:?} has no 3840x2160, stays on PipeWire", camera.display_name());
+            return false;
+        }
+        let Some(name) = Self::m52xq_libcamera_name(camera) else {
+            log::warn!("m52xq: no libcamera path in the camera properties, 4K stays on PipeWire");
+            return false;
+        };
+        let Ok(lc) = gst::ElementFactory::make("libcamerasrc")
+            .property("camera-name", &name)
+            .build()
+        else {
+            log::warn!("m52xq: no libcamerasrc (libcamera-gstreamer), 4K stays on PipeWire");
+            return false;
+        };
+        /*
+         * m52xq r116: PipeWire sends the sensor rotation as an image-orientation tag (main camera, rotation 270:
+         * rotate-90; front, rotation 90: rotate-270 - seen in the journal), gtk4paintablesink turns the viewfinder by
+         * it and the recording / photo code expects it. libcamerasrc sends no tag: the 4K viewfinder lay on its side
+         * in portrait and landscape (2026-11-18). taginject gives the same tag: rotate-(360 - rotation).
+         */
+        let rotation = camera
+            .properties()
+            .iter()
+            .find(|(k, _)| k.to_ascii_lowercase().ends_with("libcamera.rotation"))
+            .and_then(|(_, v)| v.get::<i32>().ok().or_else(|| v.get::<String>().ok()?.parse().ok()))
+            .unwrap_or(if camera.location() == crate::CameraLocation::Front { 90 } else { 270 });
+        let tag_value = format!("rotate-{}", (360 - rotation.rem_euclid(360)) % 360);
+        let tag = gst::ElementFactory::make("taginject")
+            .property("tags", format!("image-orientation=\"{tag_value}\""))
+            .build()
+            .ok();
+        let _ = pw.set_state(gst::State::Null);
+        pw.unlink(capsfilter);
+        let _ = bin.remove(pw);
+        let linked = match &tag {
+            Some(tag) => {
+                bin.add(&lc).is_ok()
+                    && bin.add(tag).is_ok()
+                    && lc.link(tag).is_ok()
+                    && tag.link(capsfilter).is_ok()
+            }
+            None => bin.add(&lc).is_ok() && lc.link(capsfilter).is_ok(),
+        };
+        if !linked {
+            log::error!("m52xq: could not link libcamerasrc, back to PipeWire");
+            let _ = bin.remove(&lc);
+            if let Some(tag) = &tag {
+                let _ = bin.remove(tag);
+            }
+            let _ = bin.add(pw);
+            let _ = pw.link(capsfilter);
+            return false;
+        }
+        // as m52xqcamsrc of 003: BGRx (other formats swapped red / blue); m52xq r116: 30 fps asked explicitly
+        // (libcamerasrc offered 10/1 and the 24 fps recording branch could not negotiate: an empty file)
+        // m52xq r118: one fixed framerate (a list / range was fixated by libcamerasrc to 10/1: empty recording); the
+        // front camera (imx616) gives at most 25 in 4K -> m52xq_lc_caps(n) steps 30, 25, 24, 20, 15 on failed starts
+        capsfilter.set_property("caps", m52xq_lc_caps(0));
+        log::info!("m52xq: libcamerasrc rotation {rotation}, tag {tag_value}");
+        imp.m52xq_lc_tag.replace(tag);
+        imp.m52xq_lc_retries.set(0);
+        imp.m52xq_lc_src.replace(Some(lc));
+        log::info!("m52xq: camera source: libcamerasrc {name}");
+        true
+    }
+
+    /// m52xq: crop the image and video branches by the current zoom (frame sizes already negotiated).
+    fn m52xq_apply_crops(&self) {
+        let zoom = self.m52xq_zoom();
+        for crop in self.imp().m52xq_crops.borrow().iter() {
+            if let Some((w, h)) = m52xq_crop_input_size(crop) {
+                m52xq_set_crop_size(crop, w, h, zoom);
+            } else if let Some(caps) = crop.static_pad("sink").and_then(|pad| pad.current_caps()) {
+                m52xq_set_crop(crop, &caps, zoom);
+            }
+        }
+    }
+
+    /// m52xq: pinch zoom, tap to focus (double tap: zoom 1x) and the autofocus timer. The camera controls of
+    /// Snapshot lie in a GtkOverlay over the viewfinder and get the touches, so the gestures go to that overlay
+    /// (capture phase, never claimed) once the viewfinder is mapped; taps on buttons are left alone.
+    fn m52xq_setup_gestures(&self) {
+        self.connect_map(|obj| {
+            let imp = obj.imp();
+            if imp.m52xq_gestures_attached.replace(true) {
+                return;
+            }
+            let target = obj
+                .ancestor(gtk::Overlay::static_type())
+                .unwrap_or_else(|| obj.clone().upcast());
+            obj.m52xq_attach_gestures(&target);
+        });
+
+        glib::timeout_add_local(
+            std::time::Duration::from_millis(30),
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                #[upgrade_or]
+                glib::ControlFlow::Break,
+                move || {
+                    obj.m52xq_af_tick();
+                    glib::ControlFlow::Continue
+                }
+            ),
+        );
+    }
+
+    /// m52xq: is (x, y) of `target` on a control (button, toggle, slider, the bottom bar) of the camera page?
+    fn m52xq_on_control(&self, target: &gtk::Widget, x: f64, y: f64) -> bool {
+        let mut widget = target.pick(x, y, gtk::PickFlags::DEFAULT);
+        while let Some(w) = widget {
+            if &w == target || w == *self.upcast_ref::<gtk::Widget>() {
+                return false;
+            }
+            let name = w.type_().name();
+            if w.is::<gtk::Button>()
+                || ["Toggle", "Scale", "Switch", "CameraControls", "Popover", "Entry", "Shutter"]
+                    .iter()
+                    .any(|n| name.contains(n))
+            {
+                return true;
+            }
+            widget = w.parent();
+        }
+        false
+    }
+
+    fn m52xq_attach_gestures(&self, target: &gtk::Widget) {
+        let zoom = gtk::GestureZoom::new();
+        zoom.set_propagation_phase(gtk::PropagationPhase::Capture);
+        zoom.connect_begin(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            move |_, _| {
+                let imp = obj.imp();
+                imp.m52xq_zooming.set(true);
+                imp.m52xq_zoom_base.set(obj.m52xq_zoom());
+            }
+        ));
+        zoom.connect_scale_changed(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            move |_, scale| {
+                // the size of the video frames must not change during a recording
+                if obj.imp().is_recording_video.borrow().is_some() {
+                    return;
+                }
+                obj.m52xq_set_zoom(obj.imp().m52xq_zoom_base.get() * scale);
+            }
+        ));
+        zoom.connect_end(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            move |_, _| {
+                let imp = obj.imp();
+                imp.m52xq_zooming.set(false);
+                imp.m52xq_zoom_end.set(Some(std::time::Instant::now()));
+                obj.m52xq_apply_crops();
+                log::info!("m52xq: viewfinder zoom {:.2}", obj.m52xq_zoom());
+            }
+        ));
+        zoom.connect_cancel(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            move |_, _| {
+                obj.imp().m52xq_zooming.set(false);
+            }
+        ));
+        target.add_controller(zoom);
+
+        let click = gtk::GestureClick::new();
+        click.set_propagation_phase(gtk::PropagationPhase::Capture);
+        click.connect_released(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            #[weak]
+            target,
+            move |_, n_press, x, y| {
+                let imp = obj.imp();
+                if obj.m52xq_on_control(&target, x, y) {
+                    return;
+                }
+                // overlay coordinates -> viewfinder coordinates
+                let Some(point) =
+                    target.compute_point(&obj, &graphene::Point::new(x as f32, y as f32))
+                else {
+                    return;
+                };
+                let (x, y) = (point.x() as f64, point.y() as f64);
+                // a finger lifted after a pinch is no tap
+                if imp.m52xq_zooming.get()
+                    || imp
+                        .m52xq_zoom_end
+                        .get()
+                        .is_some_and(|end| end.elapsed().as_millis() < 400)
+                {
+                    return;
+                }
+                if n_press == 2 {
+                    if imp.is_recording_video.borrow().is_none() {
+                        obj.m52xq_set_zoom(1.0);
+                        obj.m52xq_apply_crops();
+                    }
+                    return;
+                }
+                obj.m52xq_focus_tap(x, y);
+            }
+        ));
+        target.add_controller(click);
+        log::info!("m52xq: zoom and tap to focus on {}", target.type_().name());
+    }
+
+    /// m52xq: tap at (x, y) of the widget: focus on that point of the frame.
+    fn m52xq_focus_tap(&self, x: f64, y: f64) {
+        let imp = self.imp();
+        if imp.is_taking_picture.get() {
+            log::info!("m52xq: tap ignored, taking a picture");
+            return;
+        }
+        let w = self.width() as f64;
+        let h = self.height() as f64;
+        let aspect = self.aspect_ratio();
+        if w <= 0.0 || h <= 0.0 || aspect <= 0.0 {
+            return;
+        }
+        // undo the zoom around the middle, then the "contain" fit of the picture
+        let zoom = self.m52xq_zoom();
+        let px = w / 2.0 + (x - w / 2.0) / zoom;
+        let py = h / 2.0 + (y - h / 2.0) / zoom;
+        let (dw, dh) = if w / h > aspect {
+            (h * aspect, h)
+        } else {
+            (w, w / aspect)
+        };
+        let u = (px - (w - dw) / 2.0) / dw;
+        let v = (py - (h - dh) / 2.0) / dh;
+        if !(0.0..=1.0).contains(&u) || !(0.0..=1.0).contains(&v) {
+            log::info!("m52xq: tap at {x:.0},{y:.0} is outside the picture ({u:.2} {v:.2})");
+            return;
+        }
+        // the lens moves only on the main camera; on the others the tap shows nothing (user 2026-11-16)
+        let available = imp.m52xq_af.borrow().available();
+        log::info!("m52xq: tap at {u:.2} {v:.2}, autofocus {}", if available { "on" } else { "not available" });
+        if !available {
+            return;
+        }
+        imp.m52xq_af.borrow_mut().focus_at(u, v);
+        imp.m52xq_mark.set(Some((x as f32, y as f32)));
+        imp.m52xq_mark_start.set(Some(std::time::Instant::now()));
+        imp.m52xq_mark_until.set(None);
+        self.queue_draw();
+    }
+
+    /// m52xq: feed the newest viewfinder frame to the autofocus, hide the focus mark 1.5 s after the lock.
+    fn m52xq_af_tick(&self) {
+        let imp = self.imp();
+        let Some(sink) = imp.m52xq_af_sink.get() else {
+            return;
+        };
+        let sample = sink.emit_by_name::<Option<gst::Sample>>("try-pull-sample", &[&0u64]);
+        if let Some(sample) = sample
+            && imp.m52xq_af.borrow().available()
+            && let (Some(buffer), Some(caps)) = (sample.buffer(), sample.caps())
+            && let Ok(info) = gst_video::VideoInfo::from_caps(caps)
+        {
+            let finfo = info.format_info();
+            // m52xq r100: like the classic port, the GREEN channel of RGB frames (component 1; component 0 of BGRx
+            // is red, the noisiest in the dark); the luma (component 0) of YUV frames
+            let comp = if finfo.is_rgb() && finfo.n_components() >= 3 { 1 } else { 0 };
