+/// m52xq: bin "videoflip ! videocrop ! <convert>" used as camerabin image/video filter; the videocrop cuts
+/// the middle of the frame by the pinch zoom of the viewfinder.
+fn m52xq_flip_bin(
+    convert: &gst::Element,
+    zoom: &std::sync::Arc<std::sync::atomic::AtomicU64>,
+) -> (gst::Element, gst::Element, gst::Element) {
+    let flip = m52xq_make_flip();
+    let crop = gst::ElementFactory::make("videocrop")
+        .build()
+        .expect("Missing GStreamer Good Plug-ins (videocrop)");
+    let bin = gst::Bin::default();
+    bin.add(&flip).unwrap();
+    bin.add(&crop).unwrap();
+    bin.add(convert).unwrap();
+    flip.link(&crop).unwrap();
+    crop.link(convert).unwrap();
+    // a new frame size (image capture caps, other camera): recompute the crop with the current zoom
+    let zoom = zoom.clone();
+    crop.static_pad("sink").unwrap().add_probe(
+        gst::PadProbeType::EVENT_DOWNSTREAM,
+        move |pad, info| {
+            if let Some(gst::PadProbeData::Event(event)) = &info.data
+                && let gst::EventView::Caps(caps) = event.view()
+                && let Some(crop) = pad.parent_element()
+            {
+                m52xq_set_crop(&crop, caps.caps(), m52xq_zoom_value(&zoom));
+            }
+            gst::PadProbeReturn::Ok
+        },
+    );
+    bin.add_pad(&gst::GhostPad::with_target(&flip.static_pad("sink").unwrap()).unwrap())
+        .unwrap();
+    bin.add_pad(&gst::GhostPad::with_target(&convert.static_pad("src").unwrap()).unwrap())
+        .unwrap();
+    (bin.upcast(), flip, crop)
+}
+
+fn m52xq_zoom_value(zoom: &std::sync::atomic::AtomicU64) -> f64 {
+    f64::from_bits(zoom.load(std::sync::atomic::Ordering::Relaxed)).max(1.0)
+}
+
+/// m52xq: crop the middle 1/zoom of a frame of `caps`; the result stays a multiple of 16 pixels (encoders).
+fn m52xq_set_crop(crop: &gst::Element, caps: &gst::CapsRef, zoom: f64) {
+    let Some(s) = caps.structure(0) else {
+        return;
+    };
+    let (Ok(w), Ok(h)) = (s.get::<i32>("width"), s.get::<i32>("height")) else {
+        return;
+    };
+    m52xq_set_crop_size(crop, w, h, zoom);
+}
+
+/// m52xq r108: the frame size the crop will get = the size into its videoflip turned by the flip's CURRENT
+/// direction. The negotiated caps of the crop are stale after a display rotation (1920x1080 cut l544 r544 on a
+/// 1080 wide frame: not-negotiated, the front camera photo hung on 2026-11-17).
+fn m52xq_crop_input_size(crop: &gst::Element) -> Option<(i32, i32)> {
+    let flip = crop.static_pad("sink")?.peer()?.parent_element()?;
+    let caps = flip.static_pad("sink")?.current_caps()?;
+    let s = caps.structure(0)?;
+    let (w, h) = (s.get::<i32>("width").ok()?, s.get::<i32>("height").ok()?);
+    let dir = flip.property::<gst_video::VideoOrientationMethod>("video-direction");
+    Some(match dir {
+        gst_video::VideoOrientationMethod::_90r
+        | gst_video::VideoOrientationMethod::_90l
+        | gst_video::VideoOrientationMethod::UlLr
+        | gst_video::VideoOrientationMethod::UrLl => (h, w),
+        _ => (w, h),
+    })
+}
+
+fn m52xq_set_crop_size(crop: &gst::Element, w: i32, h: i32, zoom: f64) {
+    let side = |full: i32| -> (i32, i32) {
+        if zoom <= 1.001 || full < 64 {
+            return (0, 0);
+        }
+        let out = (((full as f64) / zoom) as i32 & !15).max(16);
+        let first = ((full - out) / 2) & !1;
+        (first, full - out - first)
+    };
+    let (left, right) = side(w);
+    let (top, bottom) = side(h);
+    crop.set_property("left", left);
+    crop.set_property("right", right);
+    crop.set_property("top", top);
+    crop.set_property("bottom", bottom);
+    log::debug!("m52xq: zoom {zoom:.2}, frame {w}x{h}, crop l{left} r{right} t{top} b{bottom}");
+}
