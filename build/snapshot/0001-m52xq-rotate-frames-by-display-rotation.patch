+/// m52xq r118/r120: caps of libcamerasrc for 4K, try n: 3840x2160 NV12 (libcamera r101 GPU debayer; BGRx as m52xqcamsrc
+/// of 003 when the libcamera has no NV12) at 30, 25, 24, 20, 15 fps
+fn m52xq_lc_caps(n: u32) -> gst::Caps {
+    const RATES: [i32; 5] = [30, 25, 24, 20, 15];
+    /*
+     * m52xq r119: the first try is a list (fixation takes 30, libcamerasrc clamps it to FrameDurationLimits: front
+     * imx616 4K = full 6528x4896 readout, 25 fps). r117 got 10/1 from the list only because of the libcamera 0.8 bug
+     * (stale sensor info in the soft IPA) fixed in libcamera r100. Later tries: one fixed rate each.
+     */
+    if n == 0 {
+        log::info!("m52xq: libcamerasrc 3840x2160 at 30/25/24/20/15 fps (list)");
+        let rates: Vec<gst::Fraction> = RATES.iter().map(|&r| gst::Fraction::new(r, 1)).collect();
+        return gst::Caps::builder("video/x-raw")
+            .field("format", gst::List::new(["NV12", "BGRx"]))
+            .field("width", 3840)
+            .field("height", 2160)
+            .field("framerate", gst::List::new(rates))
+            .build();
+    }
+    let fps = RATES[n as usize % RATES.len()];
+    log::info!("m52xq: libcamerasrc 3840x2160 at {fps} fps");
+    gst::Caps::builder("video/x-raw")
+        .field("format", gst::List::new(["NV12", "BGRx"]))
+        .field("width", 3840)
+        .field("height", 2160)
+        .field("framerate", gst::Fraction::new(fps, 1))
+        .build()
+}
+
+/// m52xq r125: video-capture-caps of camerabin: NV12 first for the 4K libcamerasrc (NV12 from the GPU debayer, no CPU
+/// conversion), I420 first for PipeWire (BGRx: one conversion, the restart after a recording negotiates)
+fn m52xq_video_caps(nv12_first: bool) -> gst::Caps {
+    let formats = if nv12_first {
+        [gst_video::VideoFormat::Nv12, gst_video::VideoFormat::I420]
+    } else {
+        [gst_video::VideoFormat::I420, gst_video::VideoFormat::Nv12]
+    };
+    gst_video::video_make_raw_caps(&formats).build()
+}
+
+/// m52xq r109: QP of the Venus encoder, M52XQ_VENC_QP="I,P" (as the pmOS Lomiri port 003), default 38/40.
+/// m52xq r121: 4K has its own M52XQ_VENC_QP_4K, default 46/48 - with 38/40 a 4K recording was ~320 Mbit/s
+/// (15.6 GB in 6.5 min, 2026-11-18; Venus rate control is off: it crashed the firmware at >= 1080p).
+fn m52xq_venc_qp() -> (i32, i32) {
+    let is_4k = crate::utils::caps::M52XQ_WANTED_HEIGHT.load(std::sync::atomic::Ordering::Relaxed) >= 2160;
+    // m52xq r123: the venus driver now really passes the QP to Iris2 (CONFIG_VENC_FRAME_QP, kernel fix 2026-11-18;
+    // before, the QP never reached the firmware): 4K 34/36 ~47 Mbit/s (as the stock firmware), 1080p 32/34
+    let (var, def) = if is_4k { ("M52XQ_VENC_QP_4K", (34, 36)) } else { ("M52XQ_VENC_QP", (32, 34)) };
+    std::env::var(var)
+        .ok()
+        .and_then(|s| {
+            let (i, p) = s.split_once(',')?;
+            Some((i.trim().parse().ok()?, p.trim().parse().ok()?))
+        })
+        .filter(|&(i, p): &(i32, i32)| (1..=51).contains(&i) && (1..=51).contains(&p))
+        .unwrap_or(def)
+}
+
+/// m52xq: a videoflip element, no rotation at start.
+fn m52xq_make_flip() -> gst::Element {
+    let flip = gst::ElementFactory::make("videoflip")
+        .build()
+        .expect("Missing GStreamer Good Plug-ins (videoflip)");
+    flip.set_property_from_str("video-direction", "identity");
+    flip
+}
