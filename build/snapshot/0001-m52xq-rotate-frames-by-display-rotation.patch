+++ b/aperture/src/m52xq_af.rs
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! m52xq: contrast autofocus for the rear main camera of the Samsung Galaxy M52 5G (s5kgw3 sensor with the
+//! fp5529 voice coil lens). Port of the plasma-camera LensAutofocus of this phone: hill climb over the lens
+//! position, the sharpness is the gradient energy of 4x4 block averages of the luma in a region of the frame
+//! (the middle 2/5 or, after a tap, a square of 1/5 of the frame around the tapped point).
+
+use std::fs::File;
+use std::os::fd::AsRawFd;
+use std::os::raw::{c_int, c_ulong};
+
+// Factory calibration of the rear main camera (EEPROM): 335 = infinity, 621 = macro.
+const INFINITY: i32 = 335;
+const MACRO: i32 = 621;
+// Frames to wait after moving the lens (VCM settling + pipeline latency).
+const SETTLE_FRAMES: i32 = 3;
+// default code of the fp5529 VCM: the peak for 1-3 m scenes lies right there (start of the search)
+const START: i32 = 345;
+const COARSE_STEP: i32 = 50;
+const FINE_STEP: i32 = 15;
+const FINE_SPAN: i32 = 40;
+// search again after a big change of the scene that lasts about 3 s (the lens must not hunt)
+const LOW_RATIO: f64 = 0.4;
+const LOW_FRAMES_TO_RETRIGGER: i32 = 45;
+const MEAN_CHANGE: f64 = 0.6;
+const HOLD_FRAMES_AFTER_CAPTURE: i32 = 90;
+
+// linux/videodev2.h
+const VIDIOC_S_CTRL: c_ulong = 0xC008_561C;
+const V4L2_CID_FOCUS_ABSOLUTE: u32 = 0x009a_090a;
+
+#[repr(C)]
+struct V4l2Control {
+    id: u32,
+    value: i32,
+}
+
+unsafe extern "C" {
+    fn ioctl(fd: c_int, request: c_ulong, ...) -> c_int;
+}
+
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+enum State {
+    #[default]
+    Disabled,
+    Settling,
+    Scanning,
+    Holding,
+}
+
+#[derive(Debug, Default)]
+pub struct LensAf {
+    lens: Option<File>,
+    available: bool,
+    state: State,
+    current: i32,
+    settle_frames: i32,
+    fine: bool,
+    stage: i32,
+    falling: i32,
+    dir: i32,
+    best_score: f64,
+    best_position: i32,
+    pos: i32,
+    fine_from: i32,
+    fine_to: i32,
+    last_locked: Option<i32>,
+    reference: f64,
+    reference_mean: f64,
+    low_frames: i32,
+    hold: i32,
+    roi: Option<(f64, f64)>,
+    /// m52xq r100: start of the running search (watchdog: a search may not take longer than 4 s)
+    search_started: Option<std::time::Instant>,
+}
+
+fn open_lens() -> Option<File> {
+    let dir = match std::fs::read_dir("/sys/class/video4linux") {
+        Ok(dir) => dir,
+        Err(err) => {
+            log::warn!("m52xq autofocus: cannot read /sys/class/video4linux: {err}");
+            return None;
+        }
+    };
+    for entry in dir.flatten() {
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        if !name.starts_with("v4l-subdev") {
+            continue;
+        }
+        let Ok(dev_name) = std::fs::read_to_string(entry.path().join("name")) else {
+            continue;
+        };
+        if !dev_name.starts_with("fp5529") {
+            continue;
+        }
+        let path = format!("/dev/{name}");
+        match std::fs::OpenOptions::new().read(true).write(true).open(&path) {
+            Ok(file) => {
+                log::info!("m52xq autofocus: using lens {path}");
+                return Some(file);
+            }
+            Err(err) => log::warn!("m52xq autofocus: cannot open {path}: {err}"),
+        }
+    }
+    log::warn!("m52xq autofocus: no fp5529 lens among the v4l-subdev devices");
+    None
+}
+
+impl LensAf {
+    pub fn available(&self) -> bool {
+        self.available
+    }
+
+    pub fn is_searching(&self) -> bool {
+        matches!(self.state, State::Settling | State::Scanning)
+    }
+
+    /// Called for every camera change: `is_lens_camera` tells whether the camera has the lens.
+    pub fn set_camera(&mut self, is_lens_camera: bool) {
+        self.roi = None;
+        if !is_lens_camera {
+            self.available = false;
+            self.state = State::Disabled;
+            return;
+        }
+        if self.lens.is_none() {
+            self.lens = open_lens();
+        }
+        self.available = self.lens.is_some();
+        if self.available {
+            self.start_scan();
+        } else {
+            self.state = State::Disabled;
+        }
+    }
+
+    fn set_position(&mut self, position: i32) {
+        let Some(lens) = self.lens.as_ref() else {
+            return;
+        };
+        let position = position.clamp(0, 1023);
+        let mut ctrl = V4l2Control {
+            id: V4L2_CID_FOCUS_ABSOLUTE,
+            value: position,
+        };
+        // SAFETY: VIDIOC_S_CTRL takes a pointer to a struct v4l2_control that lives during the call
+        let ret = unsafe { ioctl(lens.as_raw_fd(), VIDIOC_S_CTRL, &mut ctrl as *mut V4l2Control) };
+        if ret < 0 {
+            log::warn!(
+                "m52xq autofocus: VIDIOC_S_CTRL failed: {}",
+                std::io::Error::last_os_error()
+            );
+            return;
+        }
+        self.current = position;
+    }
+
+    /// Focus on the point (u, v) of the frame, 0..1 each.
+    pub fn focus_at(&mut self, u: f64, v: f64) {
+        if !self.available {
+            return;
+        }
+        self.roi = Some((u.clamp(0.0, 1.0), v.clamp(0.0, 1.0)));
+        self.hold = 0;
+        log::info!("m52xq autofocus: tap at {u:.2} {v:.2}");
+        // m52xq r100: a tap is a new subject: search from the start position like a fresh start of the classic port
+        // (from the last lock near the macro end the search never reached far subjects)
+        self.last_locked = None;
+        self.start_scan();
+    }
+
+    pub fn capture_started(&mut self) {
+        if !self.available {
+            return;
+        }
+        if self.is_searching() {
+            // in the middle of the search: go to the best position found so far
+            let target = if self.best_score > 0.0 {
+                self.best_position
+            } else {
+                self.pos
+            };
+            self.finish_search(target);
+        }
+        self.hold = HOLD_FRAMES_AFTER_CAPTURE;
+    }
+
+    fn move_to(&mut self, position: i32) {
+        self.set_position(position.clamp(INFINITY, MACRO));
+        self.settle_frames = SETTLE_FRAMES;
+        self.state = State::Settling;
+    }
+
+    fn start_scan(&mut self) {
+        self.search_started = Some(std::time::Instant::now());
+        self.fine = false;
+        self.stage = 0;
+        self.falling = 0;
+        self.dir = 1;
+        self.best_score = 0.0;
+        self.best_position = self.last_locked.unwrap_or(START);
+        self.pos = self.best_position;
+        self.low_frames = 0;
+        self.move_to(self.pos);
+    }
+
+    fn finish_search(&mut self, position: i32) {
+        self.best_position = position.clamp(INFINITY, MACRO);
+        self.last_locked = Some(self.best_position);
+        self.set_position(self.best_position);
+        self.reference = 0.0;
+        self.settle_frames = SETTLE_FRAMES;
+        self.state = State::Holding;
+        let took = self.search_started.take().map(|t| t.elapsed().as_millis()).unwrap_or(0);
+        log::info!("m52xq autofocus: locked at {} after {took} ms", self.best_position);
+    }
+
+    fn evaluate(&mut self, score: f64) {
+        log::info!("m52xq autofocus: {} {} score {score:.2}", if self.fine { "fine" } else { "coarse" }, self.pos);
+        if !self.fine {
+            if score > self.best_score {
+                self.best_score = score;
+                self.best_position = self.pos;
+                self.falling = 0;
+            } else if score < self.best_score * 0.85 {
+                self.falling += 1;
+            }
+            self.stage += 1;
+            // the first step away from the start decides the direction
+            if self.stage == 2 && self.dir > 0 && score < self.best_score * 0.95 {
+                self.dir = -1;
+                self.falling = 0;
+                self.pos = (self.best_position - COARSE_STEP).max(INFINITY);
+                self.move_to(self.pos);
+                return;
+            }
+            let next = self.pos + COARSE_STEP * self.dir;
+            if self.falling >= 2 || next > MACRO || next < INFINITY {
+                // behind the peak (or at the end of the range): fine scan around the best position
+                self.fine = true;
+                self.fine_from = (self.best_position - FINE_SPAN).max(INFINITY);
+                self.fine_to = (self.best_position + FINE_SPAN).min(MACRO);
+                self.best_score = 0.0;
+                self.pos = self.fine_from;
+                self.move_to(self.pos);
+                return;
+            }
+            self.pos = next;
+            self.move_to(self.pos);
+            return;
+        }
+
+        if score > self.best_score {
+            self.best_score = score;
+            self.best_position = self.pos;
+        }
+        if self.pos >= self.fine_to {
+            self.finish_search(self.best_position);
+            return;
+        }
+        self.pos = (self.pos + FINE_STEP).min(self.fine_to);
+        self.move_to(self.pos);
+    }
+
+    /// Feeds one frame: the luma (or another 8 bit component) at `data[offset + y * stride + x * pstride]`.
+    /// Returns true when the searching state changed (to redraw the focus mark).
+    pub fn process_frame(
+        &mut self,
+        data: &[u8],
+        stride: usize,
+        pstride: usize,
+        offset: usize,
+        width: usize,
+        height: usize,
+    ) -> bool {
+        if self.state == State::Disabled {
+            return false;
+        }
+        if self.hold > 0 {
+            self.hold -= 1;
+            return false;
+        }
+        let was_searching = self.is_searching();
+        if self.settle_frames > 0 && self.state != State::Scanning {
+            self.settle_frames -= 1;
+            if self.settle_frames > 0 {
+                return false;
+            }
+            if self.state == State::Settling {
+                self.state = State::Scanning;
+            }
+        }
+
+        let Some((score, mean)) =
+            sharpness(data, stride, pstride, offset, width, height, self.roi)
+        else {
+            return false;
+        };
+
+        // m52xq r100: watchdog
+        if self.is_searching()
+            && self.search_started.is_some_and(|t| t.elapsed() > std::time::Duration::from_secs(4))
+        {
+            log::warn!("m52xq autofocus: search took more than 4 s, taking the best position so far");
+            let target = if self.best_score > 0.0 { self.best_position } else { self.pos };
+            self.finish_search(target);
+            return true;
+        }
+
+        match self.state {
+            State::Scanning => self.evaluate(score),
+            State::Holding => {
+                if self.reference <= 0.0 {
+                    self.reference = score;
+                    self.reference_mean = mean;
+                    self.low_frames = 0;
+                } else if score < self.reference * LOW_RATIO
+                    || (mean - self.reference_mean).abs() > self.reference_mean * MEAN_CHANGE
+                {
+                    self.low_frames += 1;
+                    if self.low_frames >= LOW_FRAMES_TO_RETRIGGER {
+                        log::info!("m52xq autofocus: scene changed, searching again");
+                        self.roi = None;
+                        self.start_scan();
+                    }
+                } else {
+                    self.low_frames = 0;
+                }
+            }
+            _ => (),
+        }
+        was_searching != self.is_searching()
+    }
+}
+
+fn sharpness(
+    data: &[u8],
+    stride: usize,
+    pstride: usize,
+    offset: usize,
+    width: usize,
+    height: usize,
+    roi: Option<(f64, f64)>,
+) -> Option<(f64, f64)> {
+    if width < 64 || height < 64 || pstride == 0 {
+        return None;
+    }
+    let (roi_w, roi_h, x0, y0) = match roi {
+        Some((u, v)) => {
+            let rw = (width / 5) & !3;
+            let rh = (height / 5) & !3;
+            let x0 = ((u * width as f64) as isize - rw as isize / 2).clamp(0, (width - rw) as isize)
+                as usize
+                & !3;
+            let y0 = ((v * height as f64) as isize - rh as isize / 2)
+                .clamp(0, (height - rh) as isize) as usize
+                & !3;
+            (rw, rh, x0, y0)
+        }
+        None => {
+            let rw = (width * 2 / 5) & !3;
+            let rh = (height * 2 / 5) & !3;
+            (rw, rh, ((width - rw) / 2) & !3, ((height - rh) / 2) & !3)
+        }
+    };
+    let bw = roi_w / 4;
+    let bh = roi_h / 4;
+    // the last byte read must be inside the buffer
+    let last = offset + (y0 + bh * 4 - 1) * stride + (x0 + bw * 4 - 1) * pstride;
+    if bw < 2 || bh < 2 || last >= data.len() {
+        return None;
+    }
+
+    let mut blocks = vec![0f32; bw * bh];
+    let mut sum = 0f64;
+    for by in 0..bh {
+        for bx in 0..bw {
+            let mut acc = 0u32;
+            for j in 0..4 {
+                let line = offset + (y0 + by * 4 + j) * stride + (x0 + bx * 4) * pstride;
+                for i in 0..4 {
+                    acc += data[line + i * pstride] as u32;
+                }
+            }
+            let value = acc as f32 / 16.0;
+            blocks[by * bw + bx] = value;
+            sum += value as f64;
+        }
+    }
+    let mean = sum / (bw * bh) as f64;
+    let mut energy = 0f64;
+    for by in 0..bh - 1 {
+        for bx in 0..bw - 1 {
+            let here = blocks[by * bw + bx] as f64;
+            let gx = blocks[by * bw + bx + 1] as f64 - here;
+            let gy = blocks[(by + 1) * bw + bx] as f64 - here;
+            energy += gx * gx + gy * gy;
+        }
+    }
+    Some((
+        energy / (bw * bh) as f64 / (mean * mean).max(1.0) * 1000.0,
+        mean,
+    ))
+}
