# m52xq (дроидиан/постмаркет в3): Phosh 0.58.0 (as installed, 99990.58.0-r0) + two cellular indicators/tiles for the two
# SIM modems (a tile turns its SIM off/on with m52xq-sim-mode) and a three-state rotation tile (auto/portrait/landscape).
# splash-timeout-flatpak-dbus.patch dropped: already in 0.58. Original recipe: APKBUILD.orig-0.57.0-r3.
# r91: + cellular flight mode tile (m52xq-flight-mode), clock moved to the right of the status icons.
# r92: + screenshot with Volume Up + Volume Down (no volume change, no OSD), as in Lomiri.
# r93: + libcall-ui call screen: mute/speaker show their state.
# r94: Hold/Add call are NOT hidden (they are to be implemented); only the mute/speaker look changed.
# r94: + the battery is the last item of the top bar, the clock is left of it.
# Forked from Alpine to build against polkit with systemd session tracking
# Otherwise polkit auth agent will be broken to some mismatch for elogind/systemd session tracking
# See https://gitlab.postmarketos.org/postmarketOS/pmaports/-/work_items/4344
# Co-Maintainer: Pablo Correa Gomez <pabloyoyoista@postmarketos.org>
# Co-Maintainer: Achill Gilgenast <achill@achill.org>
maintainer="Stefan Hansson <newbyte@postmarketos.org>"
pkgname=phosh
_pkgver=0.58.0
pkgver=9999$_pkgver
pkgrel=101
pkgdesc="Wayland shell for GNOME on mobile devices"
# armhf: blocked by gnome-shell-schemas
arch="all !armhf"
url="https://gitlab.gnome.org/World/Phosh/phosh"
license="GPL-3.0-only"
triggers="$pkgname.trigger=/usr/lib/phosh/plugins/prefs"
depends="
	$pkgname-schemas
	adwaita-fonts
	adwaita-icon-theme
	bash
	dbus-x11
	dbus:org.freedesktop.Secrets
	desktop-file-utils
	gnome-control-center
	gnome-session
	gnome-settings-daemon
	gnome-shell-schemas
	gsettings-desktop-schemas
	phoc
	phosh-keyboard
	xwayland
	"
makedepends="
	$depends
	appstream-dev
	callaudiod-dev
	systemd-dev
	evince-dev
	evolution-data-server-dev
	feedbackd-dev
	gcr-dev
	gettext-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libadwaita-dev
	libgudev-dev
	libhandy1-dev
	libsecret-dev
	linux-pam-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-dev
	pulseaudio-dev
	py3-docutils
	qrcodegen-dev
	upower-dev
	wayland-dev
	wayland-protocols
	"
checkdepends="xvfb-run xmlstarlet"
# the ordering here is important - libphosh split functions need to run first to move the libphosh-0
# headers/pkgconfig/lib into the libphosh packages, before the top level -dev package gobbles
# up the rest.
subpackages="
	libphosh:libs
	libphosh-dev:libphosh_dev
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-portalsconf::noarch
	$pkgname-schemas::noarch
	$pkgname-systemd
	"
source="https://sources.phosh.mobi/releases/phosh/phosh-${_pkgver/_/.}.tar.xz
	0001-m52xq-dual-sim-indicators-and-rotation-tile.patch
	0002-m52xq-lockscreen-hold-add-call.patch
	"
builddir="$srcdir/$pkgname-${_pkgver/_/.}"
somask="libphoshsearch.so"
# crossdirect disabled because the ARMv7 cross compiler crashes internally with LTO
options="!check !pmb:crossdirect" # weird test environment, idk and dont care, tests work in Alpine

prepare() {
	default_prepare
	sed -i 's/\.rc/_rc/' meson.build
}

build() {
	# phoc tests need a running Wayland compositor
	abuild-meson \
		-Db_lto=true \
		-Dphoc_tests=disabled \
		-Dman=true \
		-Dbindings-lib=true \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild --skip-subprojects -C output
}

portalsconf() {
	install_if="$pkgname=$pkgver-r$pkgrel xdg-desktop-portal>=1.17.1"
	amove usr/share/xdg-desktop-portal/phosh-portals.conf
}

libphosh_dev() {
	amove usr/include/libphosh-*
	amove usr/lib/libphosh-*.so
	amove usr/lib/pkgconfig/libphosh-*.pc
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

