+#define M52XQ_FLIGHT_MODE "/usr/local/sbin/m52xq-flight-mode"
+#define M52XQ_FLIGHT_FLAG "/etc/m52xq/flight"
+
+/* m52xq: the flight mode tile shows the state of /etc/m52xq/flight (kept by m52xq-flight-mode) */
+static void
+m52xq_flight_update (PhoshQuickSettings *self)
+{
+  gboolean on = g_file_test (M52XQ_FLIGHT_FLAG, G_FILE_TEST_EXISTS);
+
+  phosh_status_icon_set_icon_name (self->m52xq_flight_info,
+                                   on ? "airplane-mode-symbolic" : "airplane-mode-disabled-symbolic");
+  phosh_status_icon_set_info (self->m52xq_flight_info, on ? "Flight mode on" : "Flight mode off");
+  phosh_quick_setting_set_active (self->m52xq_flight_qs, on);
+}
+
+static void
+on_m52xq_flight_changed (PhoshQuickSettings *self, GFile *file, GFile *other, GFileMonitorEvent event)
+{
+  g_autofree char *name = g_file_get_basename (file);
+
+  if (g_strcmp0 (name, "flight") == 0)
+    m52xq_flight_update (self);
+}
+
+static void
+on_m52xq_flight_clicked (PhoshQuickSettings *self, PhoshQuickSetting *child)
+{
+  /* cellular only: Wi-Fi and Bluetooth have their own tiles */
+  if (g_file_test (M52XQ_FLIGHT_FLAG, G_FILE_TEST_EXISTS))
+    m52xq_start_unit ("m52xq-flight-mode@off.service");
+  else
+    m52xq_start_unit ("m52xq-flight-mode@on.service");
+}
+
+static void
+m52xq_flight_init (PhoshQuickSettings *self)
+{
+  g_autoptr (GFile) dir = NULL;
+
+  if (!g_file_test (M52XQ_FLIGHT_MODE, G_FILE_TEST_IS_EXECUTABLE)) {
+    gtk_widget_set_visible (GTK_WIDGET (self->m52xq_flight_qs), FALSE);
+    return;
+  }
+
+  dir = g_file_new_for_path ("/etc/m52xq");
+  self->m52xq_flight_mon = g_file_monitor_directory (dir, G_FILE_MONITOR_NONE, NULL, NULL);
+  if (self->m52xq_flight_mon)
+    g_signal_connect_object (self->m52xq_flight_mon, "changed",
+                             G_CALLBACK (on_m52xq_flight_changed), self, G_CONNECT_SWAPPED);
+  m52xq_flight_update (self);
+}
+
+/*
+ * m52xq dual SIM: the SIM tiles stay visible when a SIM is off (so it can be turned on again), but a tile
+ * whose slot has no SIM card at all is hidden. Every modem object of ModemManager reports the SIM slots
+ * of the phone ("SimSlots": object path of the SIM in each slot, "/" for an empty slot). While no modem
+ * reports the slots (ModemManager restarting, SIM cards off) the tiles keep their last state.
+ */
+static void
+m52xq_slots_update (PhoshQuickSettings *self)
+{
+  g_autolist (GDBusObject) objects = NULL;
+  gboolean reported[2] = { FALSE, FALSE };
+  gboolean has_card[2] = { FALSE, FALSE };
+  PhoshQuickSetting *tiles[2] = { self->m52xq_sim1_qs, self->m52xq_sim2_qs };
+
+  if (!self->m52xq_mm)
+    return;
+
+  objects = g_dbus_object_manager_get_objects (G_DBUS_OBJECT_MANAGER (self->m52xq_mm));
+  for (GList *l = objects; l; l = l->next) {
+    MMModem *modem = mm_object_peek_modem (MM_OBJECT (l->data));
+    g_autoptr (GVariant) slots = NULL;
+    gsize n;
+
+    if (!modem)
+      continue;
+    slots = g_dbus_proxy_get_cached_property (G_DBUS_PROXY (modem), "SimSlots");
+    if (!slots || !g_variant_is_of_type (slots, G_VARIANT_TYPE ("ao")))
+      continue;
+    n = g_variant_n_children (slots);
+    for (gsize i = 0; i < 2 && i < n; i++) {
+      g_autoptr (GVariant) path = g_variant_get_child_value (slots, i);
+
+      reported[i] = TRUE;
+      if (g_strcmp0 (g_variant_get_string (path, NULL), "/") != 0)
+        has_card[i] = TRUE;
+    }
+  }
+
+  for (guint i = 0; i < 2; i++) {
+    if (!reported[i] || !tiles[i])
+      continue;
+    if (gtk_widget_get_visible (GTK_WIDGET (tiles[i])) != has_card[i])
+      g_message ("m52xq: SIM slot %u %s, %s its tile", i + 1, has_card[i] ? "has a SIM card" : "is empty",
+                 has_card[i] ? "showing" : "hiding");
+    gtk_widget_set_visible (GTK_WIDGET (tiles[i]), has_card[i]);
+  }
+}
+
+static void
+on_m52xq_modem_props_changed (PhoshQuickSettings *self)
+{
+  m52xq_slots_update (self);
+}
+
+static void
+m52xq_slots_watch_object (PhoshQuickSettings *self, GDBusObject *object)
+{
+  MMModem *modem = mm_object_peek_modem (MM_OBJECT (object));
+
+  if (modem)
+    g_signal_connect_object (modem, "g-properties-changed",
+                             G_CALLBACK (on_m52xq_modem_props_changed), self, G_CONNECT_SWAPPED);
+}
+
+static void
+on_m52xq_mm_object_added (PhoshQuickSettings *self, GDBusObject *object)
+{
+  m52xq_slots_watch_object (self, object);
+  m52xq_slots_update (self);
+}
+
+static void
+on_m52xq_mm_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autolist (GDBusObject) objects = NULL;
+  MMManager *mm = mm_manager_new_finish (res, &err);
+  PhoshQuickSettings *self;
+
+  if (!mm) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("m52xq: no ModemManager for the SIM slots: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_QUICK_SETTINGS (user_data);
+  self->m52xq_mm = mm;
+  g_signal_connect_object (mm, "object-added", G_CALLBACK (on_m52xq_mm_object_added), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (mm, "object-removed", G_CALLBACK (m52xq_slots_update), self, G_CONNECT_SWAPPED);
+  objects = g_dbus_object_manager_get_objects (G_DBUS_OBJECT_MANAGER (mm));
+  for (GList *l = objects; l; l = l->next)
+    m52xq_slots_watch_object (self, l->data);
+  m52xq_slots_update (self);
+}
+
+static void
+m52xq_slots_init (PhoshQuickSettings *self)
+{
+  g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, NULL);
+
+  if (!bus)
+    return;
+  self->m52xq_mm_cancel = g_cancellable_new ();
+  mm_manager_new (bus, G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_DO_NOT_AUTO_START, self->m52xq_mm_cancel,
+                  on_m52xq_mm_ready, self);
+}
