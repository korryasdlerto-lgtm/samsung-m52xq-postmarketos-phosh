+/*
+ * m52xq: screenshot with Volume Up + Volume Down pressed together, as in Lomiri: the volume does not
+ * change and no volume OSD is shown (the old helper service let gnome-settings-daemon change the volume
+ * first, so every screenshot had the OSD on it). A volume key press is held back for M52XQ_VOL_DELAY_MS;
+ * if the other volume key comes in that time, or while the first one is held, the presses are swallowed
+ * and Phosh takes a screenshot (same as the Print key, ~/Pictures/Screenshots).
+ */
+#define M52XQ_VOL_DELAY_MS 150
+
+static void accelerator_press (PhoshGnomeShellManager *self, AcceleratorInfo *info);
+
+static struct {
+  AcceleratorInfo *held[2];       /* 0 = lower, 1 = raise: pressed and not released yet */
+  AcceleratorInfo *pending;       /* press held back */
+  guint            pending_id;
+  gboolean         combo;         /* screenshot taken, swallow volume keys until both are released */
+} m52xq_vol;
+
+/* the accelerator is ungrabbed / freed: drop every reference to it */
+static void
+m52xq_vol_forget (gpointer info)
+{
+  for (int i = 0; i < 2; i++) {
+    if (m52xq_vol.held[i] == info)
+      m52xq_vol.held[i] = NULL;
+  }
+  if (m52xq_vol.pending == info) {
+    g_clear_handle_id (&m52xq_vol.pending_id, g_source_remove);
+    m52xq_vol.pending = NULL;
+  }
+}
+
+static int
+m52xq_vol_index (AcceleratorInfo *info)
+{
+  if (g_strcmp0 (info->accelerator, "XF86AudioLowerVolume") == 0)
+    return 0;
+  if (g_strcmp0 (info->accelerator, "XF86AudioRaiseVolume") == 0)
+    return 1;
+  return -1;
+}
+
+static gboolean
+on_m52xq_vol_pending (gpointer data)
+{
+  PhoshGnomeShellManager *self = phosh_gnome_shell_manager_get_default ();
+  AcceleratorInfo *info = m52xq_vol.pending;
+
+  m52xq_vol.pending_id = 0;
+  m52xq_vol.pending = NULL;
+  if (info && !m52xq_vol.combo)
+    accelerator_press (self, info);
+  return G_SOURCE_REMOVE;
+}
+
+/* Returns TRUE when the event was handled here */
+static gboolean
+m52xq_vol_event (PhoshGnomeShellManager *self, AcceleratorInfo *info, gboolean press)
+{
+  int i = m52xq_vol_index (info);
+
+  if (i < 0)
+    return FALSE;
+
+  if (!press) {
+    m52xq_vol.held[i] = NULL;
+    if (m52xq_vol.combo) {
+      if (!m52xq_vol.held[0] && !m52xq_vol.held[1])
+        m52xq_vol.combo = FALSE;
+      return TRUE;
+    }
+    /* a short tap: send the held back press now, then the release */
+    if (m52xq_vol.pending == info) {
+      g_clear_handle_id (&m52xq_vol.pending_id, g_source_remove);
+      m52xq_vol.pending = NULL;
+      accelerator_press (self, info);
+    }
+    return FALSE;
+  }
+
+  if (m52xq_vol.combo)
+    return TRUE;
+
+  m52xq_vol.held[i] = info;
+  if (m52xq_vol.held[1 - i]) {
+    PhoshScreenshotManager *sm = phosh_shell_get_screenshot_manager (phosh_shell_get_default ());
+
+    m52xq_vol.combo = TRUE;
+    g_clear_handle_id (&m52xq_vol.pending_id, g_source_remove);
+    m52xq_vol.pending = NULL;
+    g_clear_handle_id (&m52xq_vol.held[1 - i]->repeat_id, g_source_remove);
+    g_message ("m52xq: Volume Up + Volume Down: screenshot");
+    if (sm)
+      phosh_screenshot_manager_take_screenshot (sm, NULL, NULL, FALSE, FALSE);
+    return TRUE;
+  }
+
+  g_clear_handle_id (&m52xq_vol.pending_id, g_source_remove);
+  m52xq_vol.pending = info;
+  m52xq_vol.pending_id = g_timeout_add (M52XQ_VOL_DELAY_MS, on_m52xq_vol_pending, NULL);
+  return TRUE;
+}
