+/*
+ * m52xq dual SIM: a tap on the tile of SIM 1 / SIM 2 turns only that SIM off or on with the root helper
+ * m52xq-sim-mode (units m52xq-sim-mode@dsds|sim1|sim2, allowed for the active user by polkit; ModemManager
+ * restarts, ~30 s without network). The last active SIM is not turned off; with the SIM cards off
+ * (m52xq-flight-mode) a tap turns them on again. Without the helper the tile keeps the upstream behaviour.
+ */
+#define M52XQ_SIM_MODE "/usr/local/sbin/m52xq-sim-mode"
+
+static void
+m52xq_start_unit (const char *unit)
+{
+  g_autoptr (GError) err = NULL;
+  const char *argv[] = { "systemctl", "start", "--no-block", unit, NULL };
+
+  g_message ("m52xq: starting %s", unit);
+  if (!g_spawn_async (NULL, (char **)argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &err))
+    g_warning ("m52xq: could not start %s: %s", unit, err->message);
+}
+
+static gboolean
+m52xq_toggle_sim (guint slot)
+{
+  g_autofree char *mode = NULL;
+  const char *unit = NULL;
+
+  if (!g_file_test (M52XQ_SIM_MODE, G_FILE_TEST_IS_EXECUTABLE))
+    return FALSE;
+
+  if (g_file_test ("/etc/m52xq/flight", G_FILE_TEST_EXISTS)) {
+    /* SIMs off: turn on the SIM that was tapped ("only SIM n"; in flight mode m52xq-sim-mode only saves the choice),
+     * then leave flight mode, which applies the saved mode */
+    g_autoptr (GError) err = NULL;
+    const char *mode_unit = slot == 1 ? "m52xq-sim-mode@sim1.service" : "m52xq-sim-mode@sim2.service";
+    const char *argv[] = { "sh", "-c",
+                           "systemctl start \"$1\" && systemctl start --no-block m52xq-flight-mode@off.service",
+                           "m52xq-sim-on", mode_unit, NULL };
+
+    g_message ("m52xq: SIMs off, turning on SIM %u (%s, then flight mode off)", slot, mode_unit);
+    if (!g_spawn_async (NULL, (char **)argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &err))
+      g_warning ("m52xq: could not turn on SIM %u: %s", slot, err->message);
+    return TRUE;
+  }
+
+  if (!g_file_get_contents ("/etc/m52xq/sim-mode", &mode, NULL, NULL))
+    mode = g_strdup ("dsds");
+  g_strstrip (mode);
+
+  if (g_strcmp0 (mode, "sim1") == 0)
+    unit = slot == 2 ? "m52xq-sim-mode@dsds.service" : "m52xq-flight-mode@on.service"; /* last SIM: all SIMs off */
+  else if (g_strcmp0 (mode, "sim2") == 0)
+    unit = slot == 1 ? "m52xq-sim-mode@dsds.service" : "m52xq-flight-mode@on.service";
+  else
+    unit = slot == 1 ? "m52xq-sim-mode@sim2.service" : "m52xq-sim-mode@sim1.service";
+
+  if (unit)
+    m52xq_start_unit (unit);
+  else
+    g_message ("m52xq: SIM %u is the only active SIM, not turning it off", slot);
+  return TRUE;
+}
+
+static void
+on_wwan2_clicked (PhoshQuickSettings *self, PhoshQuickSetting *child)
