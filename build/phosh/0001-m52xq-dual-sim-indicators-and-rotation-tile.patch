+/*
+ * m52xq: phosh claims the accelerometer only on events (sensor appears, blank state or orientation lock
+ * changes). After some boots it never claimed it (auto rotation dead until a new login, 2026-11-13 and
+ * 2026-11-15). Check every 5 s: automatic rotation wanted, screen not blanked, not claimed -> claim.
+ * A restart of iio-sensor-proxy (new bus name owner) drops all claims: claim again.
+ */
+/* m52xq r101: ask iio-sensor-proxy itself whether there is an accelerometer. The cached property of the proxy stayed
+ * FALSE when the ADSP accelerometer appeared ~1 s after phosh had started (first boot after an install, fast login), so
+ * phosh never switched to the sensor mode and the r100 watch, which read the same cache, stayed silent. */
+static gboolean
+m52xq_has_accelerometer_now (PhoshRotationManager *self)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) value = NULL;
+  gboolean has;
+
+  reply = g_dbus_proxy_call_sync (G_DBUS_PROXY (self->sensor_proxy_manager),
+                                  "org.freedesktop.DBus.Properties.Get",
+                                  g_variant_new ("(ss)", "net.hadess.SensorProxy", "HasAccelerometer"),
+                                  G_DBUS_CALL_FLAGS_NONE, 1000, NULL, &err);
+  if (!reply) {
+    g_message ("m52xq: cannot ask iio-sensor-proxy for the accelerometer: %s", err->message);
+    return FALSE;
+  }
+  g_variant_get (reply, "(v)", &value);
+  has = g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN) && g_variant_get_boolean (value);
+  if (has && !phosh_dbus_sensor_proxy_get_has_accelerometer (PHOSH_DBUS_SENSOR_PROXY (self->sensor_proxy_manager))) {
+    g_message ("m52xq: iio-sensor-proxy has an accelerometer but the cached property says no: updating the cache");
+    g_dbus_proxy_set_cached_property (G_DBUS_PROXY (self->sensor_proxy_manager), "HasAccelerometer",
+                                      g_variant_new_boolean (TRUE));
+  }
+  return has;
+}
+
+static void
+m52xq_watch_skip (PhoshRotationManager *self, int reason, const char *text)
+{
+  if (self->m52xq_last_skip == reason)
+    return;
+  self->m52xq_last_skip = reason;
+  if (text)
+    g_message ("m52xq: rotation watch: %s", text);
+}
+
+/*
+ * m52xq: phosh claims the accelerometer only on events (sensor appears, blank state or orientation lock
+ * changes). After some boots it never claimed it (auto rotation dead until a new login, 2026-11-13, 2026-11-15 and
+ * 2026-11-16 after the install of v6). Every 5 s: automatic rotation wanted, screen not blanked, not claimed -> claim.
+ * A restart of iio-sensor-proxy (new bus name owner) drops all claims: claim again.
+ */
+static gboolean
+m52xq_claim_watch (gpointer data)
+{
+  PhoshRotationManager *self = PHOSH_ROTATION_MANAGER (data);
+  gboolean blanked = !!(phosh_shell_get_state (phosh_shell_get_default ()) & PHOSH_STATE_BLANKED);
+
+  if (self->claimed) {
+    m52xq_watch_skip (self, 0, NULL);
+    return G_SOURCE_CONTINUE;
+  }
+  if (!self->sensor_proxy_manager) {
+    m52xq_watch_skip (self, 1, "no sensor proxy");
+    return G_SOURCE_CONTINUE;
+  }
+  if (self->orientation_locked) {
+    m52xq_watch_skip (self, 2, "orientation locked, not claiming");
+    return G_SOURCE_CONTINUE;
+  }
+  if (blanked) {
+    m52xq_watch_skip (self, 3, "screen blanked, not claiming");
+    return G_SOURCE_CONTINUE;
+  }
+  if (!m52xq_has_accelerometer_now (self)) {
+    m52xq_watch_skip (self, 4, "no accelerometer in iio-sensor-proxy yet");
+    return G_SOURCE_CONTINUE;
+  }
+  m52xq_watch_skip (self, 5, NULL);
+  if (self->mode == PHOSH_ROTATION_MANAGER_MODE_OFF) {
+    g_message ("m52xq: accelerometer present but rotation mode off, enabling sensor mode");
+    phosh_rotation_manager_set_mode (self, PHOSH_ROTATION_MANAGER_MODE_SENSOR);
+  } else {
+    g_message ("m52xq: accelerometer not claimed while rotation is automatic, claiming again");
+    phosh_rotation_manager_claim_accelerometer (self, TRUE);
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+m52xq_on_proxy_owner_changed (PhoshRotationManager *self)
+{
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (G_DBUS_PROXY (self->sensor_proxy_manager));
+
+  if (g_strcmp0 (owner, self->m52xq_proxy_owner) == 0)
+    return;
+
+  g_message ("m52xq: iio-sensor-proxy owner %s -> %s", self->m52xq_proxy_owner ?: "-", owner ?: "-");
+  g_free (self->m52xq_proxy_owner);
+  self->m52xq_proxy_owner = g_strdup (owner);
+  /* claims belong to the old instance: forget ours, the watch claims again */
+  self->claimed = FALSE;
+  if (owner)
+    claim_or_release_accelerometer (self);
+}
