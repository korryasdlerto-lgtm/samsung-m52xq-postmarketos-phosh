+/* m52xq: the Hold toggle follows the state of the call; Hold and Add call work for active / held calls that can be held */
+static void
+m52xq_sync_hold (CuiCallDisplay *self, CuiCallState state)
+{
+  gboolean can_hold = self->call && cui_call_get_can_hold (self->call);
+  gboolean holdable = can_hold && (state == CUI_CALL_STATE_ACTIVE || state == CUI_CALL_STATE_HELD);
+
+  gtk_widget_set_sensitive (GTK_WIDGET (self->hold), holdable);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->add_call), holdable);
+
+  g_signal_handlers_block_by_func (self->hold, hold_toggled_cb, self);
+  gtk_toggle_button_set_active (self->hold, state == CUI_CALL_STATE_HELD);
+  m52xq_toggle_style (self->hold, NULL, NULL);
+  g_signal_handlers_unblock_by_func (self->hold, hold_toggled_cb, self);
+}
