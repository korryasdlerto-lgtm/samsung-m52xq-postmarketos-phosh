+/* m52xq: Add call on the call screen of the lock screen: hold the call, open the dial pad of Calls and ask to unlock */
+static void
+on_m52xq_add_call (PhoshLockscreen *self)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+  CuiCall *call = cui_call_display_get_call (priv->call_display);
+
+  if (call && cui_call_get_state (call) == CUI_CALL_STATE_ACTIVE)
+    cui_call_hold (call, TRUE);
+
+  g_dbus_connection_call (g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL),
+                          "org.gnome.Calls", "/org/gnome/Calls",
+                          "org.freedesktop.Application", "ActivateAction",
+                          g_variant_new_parsed ("('show-dial-pad', @av [], @a{sv} {})"),
+                          NULL, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+
+  show_unlock_page (self);
+}
