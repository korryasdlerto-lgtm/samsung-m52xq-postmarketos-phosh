+/* m52xq: hold / resume through the Calls D-Bus API (Hold, CanHold) */
+static gboolean
+phosh_call_get_can_hold (CuiCall *call)
+{
+  PhoshCall *self;
+
+  g_return_val_if_fail (PHOSH_IS_CALL (call), FALSE);
+  self = PHOSH_CALL (call);
+
+  return phosh_dbus_calls_call_get_can_hold (self->proxy);
+}
+
+
+static void
+on_call_hold_finish (GObject *source_object, GAsyncResult *res, gpointer unused)
+{
+  PhoshDBusCallsCall *proxy = PHOSH_DBUS_CALLS_CALL (source_object);
+  g_autoptr (GError) err = NULL;
+
+  g_return_if_fail (PHOSH_DBUS_IS_CALLS_CALL_PROXY (proxy));
+
+  if (!phosh_dbus_calls_call_call_hold_finish (proxy, res, &err))
+    phosh_async_error_warn (err, "Failed to hold/resume call %p", proxy);
+}
+
+
+static void
+phosh_call_hold (CuiCall *call, gboolean hold)
+{
+  PhoshCall *self;
+
+  g_return_if_fail (PHOSH_IS_CALL (call));
+  self = PHOSH_CALL (call);
+
+  phosh_dbus_calls_call_call_hold (self->proxy, hold, self->cancel, on_call_hold_finish, NULL);
+}
+
+
 static void
 phosh_call_cui_call_interface_init (CuiCallInterface *iface)
 {
+  iface->get_can_hold = phosh_call_get_can_hold;
+  iface->hold = phosh_call_hold;
   iface->get_avatar_icon = phosh_call_get_avatar_icon;
   iface->get_id = phosh_call_get_id;
   iface->get_display_name = phosh_call_get_display_name;
