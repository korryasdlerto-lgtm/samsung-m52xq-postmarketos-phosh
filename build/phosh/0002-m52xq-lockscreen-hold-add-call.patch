 /**
+ * cui_call_get_can_hold:
+ * @self: The call
+ *
+ * Returns: whether the call can be put on hold and resumed (m52xq)
+ */
+gboolean
+cui_call_get_can_hold (CuiCall *self)
+{
+  CuiCallInterface *iface;
+
+  g_return_val_if_fail (CUI_IS_CALL (self), FALSE);
+
+  iface = CUI_CALL_GET_IFACE (self);
+  if (!iface->get_can_hold || !iface->hold)
+    return FALSE;
+
+  return iface->get_can_hold (self);
+}
+
+/**
+ * cui_call_hold:
+ * @self: The call
+ * @hold: %TRUE to put the call on hold, %FALSE to resume it
+ *
+ * m52xq: put an active call on hold or resume a held one.
+ */
+void
+cui_call_hold (CuiCall *self, gboolean hold)
+{
+  CuiCallInterface *iface;
+
+  g_return_if_fail (CUI_IS_CALL (self));
+
+  iface = CUI_CALL_GET_IFACE (self);
+  if (!iface->hold)
+    return;
+
+  iface->hold (self, hold);
+}
+
+/**
  * cui_call_accept:
  * @self: The call
  *
