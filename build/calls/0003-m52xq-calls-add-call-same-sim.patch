 G_DEFINE_TYPE (CallsNewCallBox, calls_new_call_box, ADW_TYPE_BIN);
 
 
+/* m52xq: with two SIMs in dual standby the modem refuses a call on the other SIM while a call (even a held one) exists
+ * (QMI DeviceInUse). A second call (Add call) therefore always goes through the origin of the existing call. */
+static CallsOrigin *
+m52xq_find_busy_origin (CallsNewCallBox *self)
+{
+  GListModel *model = adw_combo_row_get_model (self->origin_list);
+  guint n_items = model ? g_list_model_get_n_items (model) : 0;
+
+  for (guint i = 0; i < n_items; i++) {
+    g_autoptr (CallsOrigin) origin = g_list_model_get_item (model, i);
+    g_autoptr (GList) calls = calls_origin_get_calls (origin);
+
+    for (GList *l = calls; l; l = l->next) {
+      if (calls_call_get_state (CALLS_CALL (l->data)) != CALLS_CALL_STATE_DISCONNECTED)
+        return g_steal_pointer (&origin);
+    }
+  }
+
+  return NULL;
+}
+
+
+/* m52xq: select the origin of the existing call in the list and lock the choice while that call exists */
+static void
+m52xq_sync_busy_origin (CallsNewCallBox *self)
+{
+  g_autoptr (CallsOrigin) busy = m52xq_find_busy_origin (self);
+  GListModel *model = adw_combo_row_get_model (self->origin_list);
+
+  gtk_widget_set_sensitive (GTK_WIDGET (self->origin_list_box), busy == NULL);
+
+  if (!busy || !model)
+    return;
+
+  for (guint i = 0; i < g_list_model_get_n_items (model); i++) {
+    g_autoptr (CallsOrigin) origin = g_list_model_get_item (model, i);
+
+    if (origin == busy) {
+      if (adw_combo_row_get_selected (self->origin_list) != i)
+        adw_combo_row_set_selected (self->origin_list, i);
+      break;
+    }
+  }
+}
+
+
