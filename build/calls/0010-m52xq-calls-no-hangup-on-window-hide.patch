diff --git a/src/calls-application.c b/src/calls-application.c
index 2e579d5..2f11bd0 100644
--- a/src/calls-application.c
+++ b/src/calls-application.c
@@ -633,9 +633,15 @@ notify_window_visible_cb (GtkWidget        *window,
   g_return_if_fail (CALLS_IS_APPLICATION (application));
   g_return_if_fail (CALLS_IS_CALL_WINDOW (window));
 
-  /* The UI is being closed, hang up active calls */
-  if (!gtk_widget_is_visible (window))
-    calls_manager_hang_up_all_calls (manager);
+  /* m52xq: the call window is hidden when its last call goes away; hanging up "all calls" at that moment crashed
+   * (SIGSEGV in calls_manager_hang_up_all_calls on a call that was being removed, 2026-11-14, incoming call after a
+   * resume). On the phone the window is never closed by the user while a call is running, so nothing is hung up here. */
+  if (!gtk_widget_is_visible (window)) {
+    GList *calls = calls_manager_get_calls (manager);
+
+    g_message ("m52xq: call window hidden (%u calls left), not hanging up", g_list_length (calls));
+    g_list_free (calls);
+  }
 }
 
 
