diff --git a/plugins/provider/mm/calls-mm-origin.c b/plugins/provider/mm/calls-mm-origin.c
index 808ba4f..ae53ba0 100644
--- a/plugins/provider/mm/calls-mm-origin.c
+++ b/plugins/provider/mm/calls-mm-origin.c
@@ -395,6 +395,9 @@ remove_calls (CallsMMOrigin *self, const char *reason)
 
   paths = g_hash_table_get_keys (self->calls);
 
+  if (paths)
+    g_message ("m52xq: origin %s goes away, removing its %u calls", self->name ? self->name : "?", g_list_length (paths));
+
   for (GList *node = paths; node != NULL; node = node->next) {
     g_hash_table_steal_extended (self->calls, node->data, NULL, &call);
     g_signal_emit_by_name (self, "call-removed",
@@ -598,7 +601,7 @@ call_deleted_cb (MMModemVoice *voice,
   g_assert (CALLS_IS_MM_ORIGIN (user_data));
   self = CALLS_MM_ORIGIN (user_data);
 
-  g_debug ("Removing call `%s'", path);
+  g_message ("m52xq: ModemManager deleted call `%s'", path);
 
   g_hash_table_steal_extended (self->calls, path, &key, &call);
 
