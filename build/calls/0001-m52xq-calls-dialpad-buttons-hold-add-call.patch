+/*
+ * m52xq: hold / resume through the HoldAndAccept of the modem's Voice interface (tested on the M52: with one active call it puts
+ * it on hold, with one held call it resumes it; the voice path of m52xq-voicecall follows the call state). The modem of the call
+ * is set by the origin ("m52xq-voice").
+ */
+static void
+hold_and_accept_cb (MMModemVoice *voice,
+                    GAsyncResult *res,
+                    CallsMMCall  *self)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!mm_modem_voice_hold_and_accept_finish (voice, res, &error)) {
+    g_warning ("Error holding / resuming MM call: %s", error->message);
+    CALLS_ERROR (self, error);
+  }
+
+  g_object_unref (self);
+}
+
+static void
+calls_mm_call_hold (CallsCall *call, gboolean hold)
+{
+  CallsMMCall *self = CALLS_MM_CALL (call);
+  MMModemVoice *voice = g_object_get_data (G_OBJECT (self), "m52xq-voice");
+  CallsCallState state = calls_call_get_state (call);
+
+  if (!voice) {
+    g_warning ("MM call without a modem voice interface, cannot hold");
+    return;
+  }
+
+  /* HoldAndAccept toggles: only act when the call is in the state the button wants to leave */
+  if (hold ? state != CALLS_CALL_STATE_ACTIVE : state != CALLS_CALL_STATE_HELD)
+    return;
+
+  mm_modem_voice_hold_and_accept (voice, NULL, (GAsyncReadyCallback) hold_and_accept_cb, g_object_ref (self));
+}
+
