# m52xq (дроидиан/постмаркет в3): dial pad in landscape: number and call button left, keys right, no scrolling
# r93: Hold (HoldAndAccept of the modem) and Add call (hold + dial pad) work; r91/r92: mute/speaker show their state. Landscape dial pad.
# (libcall-ui CuiDialpad, switches on the window size; portrait unchanged).
# Contributor: Bart Ribbers <bribbers@disroot.org>
maintainer="team/gnome <achill@achill.org>"
pkgname=calls
pkgver=51.1
pkgrel=108
pkgdesc="Phone dialer and call handler"
arch="all"
url="https://gitlab.gnome.org/GNOME/calls"
license="GPL-3.0-or-later"
depends="
	callaudiod
	modemmanager
	sofia-sip-linphone
	"
makedepends="
	callaudiod-dev
	desktop-file-utils
	evolution-data-server-dev
	feedbackd-dev
	folks-dev
	gettext-dev
	gmobile-dev
	gobject-introspection-dev
	gom-dev
	gsound-dev
	gstreamer-dev
	gtk4.0-dev
	libadwaita-dev
	libpeas2-dev
	meson
	mobile-broadband-provider-info
	modemmanager-dev
	ninja
	py3-docutils
	sofia-sip-linphone-dev
	vala
	"
subpackages="$pkgname-doc $pkgname-dbg $pkgname-lang $pkgname-systemd"
source="https://download.gnome.org/sources/calls/${pkgver%%.*}/calls-$pkgver.tar.xz
	0001-m52xq-calls-dialpad-buttons-hold-add-call.patch
	0002-m52xq-calls-dbus-hold.patch
	0003-m52xq-calls-add-call-same-sim.patch
	0004-m52xq-calls-allow-second-call.patch
	0005-m52xq-calls-show-remaining-call.patch
	0006-m52xq-calls-swap-button.patch
	0007-m52xq-calls-present-window-after-call-ends.patch
	0008-m52xq-calls-sim-in-history.patch
	0009-m52xq-calls-swap-in-main-window.patch
	0010-m52xq-calls-no-hangup-on-window-hide.patch
	0011-m52xq-calls-sim-history-no-origin-unref.patch
	0012-m52xq-calls-landscape-call-display.patch
	0013-m52xq-calls-present-window-for-second-call.patch
	"
options="!check" # Requires running Wayland compositor

build() {
	abuild-meson \
		-Db_lto=true \
		-Dtests="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

