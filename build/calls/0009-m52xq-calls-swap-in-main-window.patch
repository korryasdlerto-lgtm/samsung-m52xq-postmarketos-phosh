+/* m52xq: "Swap" in the main window: the same as the button of the call window */
+static void
+m52xq_swap_calls (GSimpleAction *action,
+                  GVariant      *parameter,
+                  gpointer       user_data)
+{
+  CallsApplication *app = CALLS_APPLICATION (user_data);
+
+  if (app->call_window)
+    calls_call_window_m52xq_swap (app->call_window);
+}
