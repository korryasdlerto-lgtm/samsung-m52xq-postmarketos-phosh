 /* m52xq: Add call during a call */
+/* m52xq: banner "Swap" while there are two calls (the call window may be behind this one) */
+void
+calls_main_window_m52xq_set_swap (CallsMainWindow *self,
+                                  gboolean         visible,
+                                  gboolean         sensitive,
+                                  const char      *title)
+{
+  g_return_if_fail (CALLS_IS_MAIN_WINDOW (self));
+
+  adw_banner_set_title (self->m52xq_swap_banner, title ? title : "");
+  adw_banner_set_button_label (self->m52xq_swap_banner, sensitive ? "Swap" : NULL);
+  adw_banner_set_revealed (self->m52xq_swap_banner, visible);
+}
