diff --git a/src/calls-call-window.c b/src/calls-call-window.c
index c3479d0..054ed77 100644
--- a/src/calls-call-window.c
+++ b/src/calls-call-window.c
@@ -27,6 +27,7 @@
 #define G_LOG_DOMAIN "CallsCallWindow"
 
 #include "calls-call-window.h"
+#include "calls-main-window.h"
 #include "calls-origin.h"
 #include "calls-call-selector-item.h"
 #include "calls-new-call-box.h"
@@ -101,12 +102,39 @@ update_swap_button (CallsCallWindow *self)
 
   gtk_widget_set_visible (GTK_WIDGET (self->swap_calls), n > 1);
   gtk_widget_set_sensitive (GTK_WIDGET (self->swap_calls), n > 1 && can_swap);
+
+  /* m52xq: the same "Swap" in the main window (it is in front after "Add call"): a banner with the calls,
+   * ▶ = active, ⏸ = on hold */
+  {
+    GtkApplication *app = gtk_window_get_application (GTK_WINDOW (self));
+    g_autoptr (GString) title = g_string_new (NULL);
+
+    for (guint i = 0; i < n; i++) {
+      g_autoptr (CallsCallSelectorItem) item = g_list_model_get_item (G_LIST_MODEL (self->calls), i);
+      CuiCall *call = cui_call_display_get_call (calls_call_selector_item_get_display (item));
+      CuiCallState state = cui_call_get_state (call);
+      const char *name = cui_call_get_display_name (call);
+
+      if (!name || !*name)
+        name = cui_call_get_id (call);
+      if (title->len)
+        g_string_append (title, "    ");
+      g_string_append_printf (title, "%s %s",
+                              state == CUI_CALL_STATE_HELD ? "⏸" :
+                              state == CUI_CALL_STATE_ACTIVE ? "▶" : "…",
+                              name ? name : "");
+    }
+
+    for (GList *l = app ? gtk_application_get_windows (app) : NULL; l; l = l->next) {
+      if (CALLS_IS_MAIN_WINDOW (l->data))
+        calls_main_window_m52xq_set_swap (CALLS_MAIN_WINDOW (l->data), n > 1, n > 1 && can_swap, title->str);
+    }
+  }
 }
 
 
