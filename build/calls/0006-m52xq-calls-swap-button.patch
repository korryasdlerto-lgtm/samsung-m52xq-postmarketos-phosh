+/* m52xq: "Swap": put the active call on hold (HoldAndAccept of the modem swaps the active and the held call) */
+static void
+update_swap_button (CallsCallWindow *self)
+{
+  guint n = g_list_model_get_n_items (G_LIST_MODEL (self->calls));
+  gboolean can_swap = FALSE;
+
+  for (guint i = 0; i < n; i++) {
+    g_autoptr (CallsCallSelectorItem) item = g_list_model_get_item (G_LIST_MODEL (self->calls), i);
+    CuiCall *call = cui_call_display_get_call (calls_call_selector_item_get_display (item));
+    CuiCallState state = cui_call_get_state (call);
+
+    if (state == CUI_CALL_STATE_ACTIVE || state == CUI_CALL_STATE_HELD)
+      can_swap = TRUE;
+  }
+
+  gtk_widget_set_visible (GTK_WIDGET (self->swap_calls), n > 1);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->swap_calls), n > 1 && can_swap);
+}
+
+
+static void
+swap_calls_clicked_cb (GtkButton       *button,
+                       CallsCallWindow *self)
+{
+  guint n = g_list_model_get_n_items (G_LIST_MODEL (self->calls));
+  CuiCall *held = NULL;
+
+  for (guint i = 0; i < n; i++) {
+    g_autoptr (CallsCallSelectorItem) item = g_list_model_get_item (G_LIST_MODEL (self->calls), i);
+    CuiCall *call = cui_call_display_get_call (calls_call_selector_item_get_display (item));
+    CuiCallState state = cui_call_get_state (call);
+
+    if (state == CUI_CALL_STATE_ACTIVE && cui_call_get_can_hold (call)) {
+      cui_call_hold (call, TRUE);   /* the held call becomes active */
+      return;
+    }
+    if (state == CUI_CALL_STATE_HELD && !held)
+      held = call;
+  }
+
+  if (held && cui_call_get_can_hold (held))
+    cui_call_hold (held, FALSE);
+}
+
+
+static void
+on_call_state_changed_swap (CuiCall         *call,
+                            GParamSpec      *pspec,
+                            CallsCallWindow *self)
+{
+  update_swap_button (self);
+}
+
