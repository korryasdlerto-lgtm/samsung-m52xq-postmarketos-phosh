     G_GNUC_FALLTHROUGH;
 
   case CUI_CALL_STATE_CALLING:
@@ -412,7 +541,7 @@
   self->update_status_time = TRUE;
   adw_avatar_set_custom_image (self->avatar, NULL);
   adw_avatar_set_text (self->avatar, "");
-  adw_avatar_set_size (self->avatar, ADW_AVATAR_SIZE_DEFAULT);
+  m52xq_set_avatar_size (self, ADW_AVATAR_SIZE_DEFAULT);
   gtk_label_set_label (self->primary_contact_info, "");
   gtk_label_set_label (self->secondary_contact_info, "");
   gtk_label_set_label (self->status, "");
@@ -530,6 +659,9 @@
 
   GtkWidget *overlay = GTK_WIDGET (self->overlay);
 
+  g_clear_handle_id (&self->m52xq_layout_id, g_source_remove); /* m52xq r104 */
+  m52xq_on_unrealize (NULL, self);                              /* m52xq r105 */
+
   g_clear_pointer (&overlay, gtk_widget_unparent);
 
   if (self->call) {
@@ -594,6 +726,8 @@
   gtk_widget_class_bind_template_child (widget_class, CuiCallDisplay, secondary_contact_info);
   gtk_widget_class_bind_template_child (widget_class, CuiCallDisplay, speaker);
   gtk_widget_class_bind_template_child (widget_class, CuiCallDisplay, status);
+  gtk_widget_class_bind_template_child (widget_class, CuiCallDisplay, main_box);   /* m52xq r104 */
+  gtk_widget_class_bind_template_child (widget_class, CuiCallDisplay, action_box); /* m52xq r104 */
   gtk_widget_class_bind_template_callback (widget_class, add_call_clicked_cb);
   gtk_widget_class_bind_template_callback (widget_class, block_delete_cb);
   gtk_widget_class_bind_template_callback (widget_class, hide_dial_pad_clicked_cb);
@@ -612,6 +746,33 @@
 cui_call_display_init (CuiCallDisplay *self)
 {
   gtk_widget_init_template (GTK_WIDGET (self));
+
+  /*
+   * m52xq r107: the content in a scrolled window with an almost zero minimum size. GTK never makes a window smaller than
+   * its content: after a rotation the previous layout (horizontal ~830 wide, vertical ~600 high) enlarged the call
+   * window beyond the screen for a moment and it never shrank again (r106: content shifted right in portrait, the
+   * buttons below the screen in landscape). The scrolled window shows its natural size when it fits.
+   */
+  {
+    GtkWidget *content = GTK_WIDGET (self->main_box);
+    GtkWidget *sw = gtk_scrolled_window_new ();
+
+    g_object_ref (content);
+    gtk_overlay_set_child (self->overlay, NULL);
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (sw), GTK_POLICY_AUTOMATIC, GTK_POLICY_AUTOMATIC);
+    gtk_scrolled_window_set_propagate_natural_width (GTK_SCROLLED_WINDOW (sw), TRUE);
+    gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (sw), TRUE);
+    gtk_widget_set_hexpand (sw, TRUE);
+    gtk_widget_set_vexpand (sw, TRUE);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (sw), content);
+    gtk_overlay_set_child (self->overlay, sw);
+    g_object_unref (content);
+  }
+
+  /* m52xq r106: the layout follows the size of the screen (monitor) */
+  g_signal_connect (self, "realize", G_CALLBACK (m52xq_on_realize), self);
+  g_signal_connect (self, "unrealize", G_CALLBACK (m52xq_on_unrealize), self);
+
   /* m52xq: initial look of the toggles */
   m52xq_toggle_style (self->mute, M52XQ_MUTE_ICONS);
   m52xq_toggle_style (self->speaker, NULL, NULL);
