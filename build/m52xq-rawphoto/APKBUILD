# Maintainer: Asdlerto Korry <korryasdlerto@gmail.com>
# m52xq: full-resolution photo helper (main camera 64 MP, front 32 MP) for camera apps that use PipeWire (Snapshot).
# Port of the raw capture + GPU development of the m52xq plasma-camera build (r36).
pkgname=m52xq-rawphoto
pkgver=1
pkgrel=3
pkgdesc="Samsung Galaxy M52 5G: full-resolution raw photo capture and GPU development"
url="https://github.com/korryasdlerto-lgtm/samsung-m52xq-postmarketos-phosh"
arch="aarch64"
license="GPL-2.0-or-later"
makedepends="libcamera-dev libepoxy-dev libjpeg-turbo-dev linux-headers"
source="m52xq-rawphoto.cpp rawphoto.c rawphoto.h photo_gpu.c photo_gpu.h"
builddir="$srcdir"
options="!check"

build() {
	gcc $CFLAGS -O2 -Wall -c rawphoto.c -o rawphoto.o $(pkg-config --cflags epoxy)
	gcc $CFLAGS -O2 -Wall -c photo_gpu.c -o photo_gpu.o $(pkg-config --cflags epoxy libjpeg)
	g++ $CXXFLAGS -O2 -Wall -std=c++20 -c m52xq-rawphoto.cpp -o m52xq-rawphoto.o $(pkg-config --cflags libcamera)
	g++ $LDFLAGS -o m52xq-rawphoto m52xq-rawphoto.o rawphoto.o photo_gpu.o \
		$(pkg-config --libs libcamera epoxy libjpeg) -lm
}

package() {
	install -Dm755 m52xq-rawphoto "$pkgdir"/usr/bin/m52xq-rawphoto
}
