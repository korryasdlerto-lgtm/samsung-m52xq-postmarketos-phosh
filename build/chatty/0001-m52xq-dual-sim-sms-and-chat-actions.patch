diff --git a/src/mm/chatty-mm-account.c b/src/mm/chatty-mm-account.c
index 2552afe..4b5e215 100644
--- a/src/mm/chatty-mm-account.c
+++ b/src/mm/chatty-mm-account.c
@@ -47,6 +47,66 @@ struct _ChattyMmDevice
 
 G_DEFINE_TYPE (ChattyMmDevice, chatty_mm_device, G_TYPE_OBJECT)
 
+/*
+ * m52xq dual SIM: with both SIMs active ModemManager has one modem object per SIM, model "SIM 1" / "SIM 2"
+ * (our ModemManager build). Chatty sent every SMS through the first modem; now each chat has a SIM:
+ * the one chosen in the chat (button next to the attachment button) or else the SIM on which the last
+ * message of that number came in. Kept in ~/.local/share/chatty/m52xq-chat-sim.ini.
+ */
+static guint
+m52xq_device_slot (ChattyMmDevice *device)
+{
+  const char *model;
+
+  if (!device || !device->mm_object || !mm_object_peek_modem (device->mm_object))
+    return 0;
+  model = mm_modem_get_model (mm_object_peek_modem (device->mm_object));
+  if (g_strcmp0 (model, "SIM 1") == 0)
+    return 1;
+  if (g_strcmp0 (model, "SIM 2") == 0)
+    return 2;
+  return 0;
+}
+
+static char *
+m52xq_sim_store_path (void)
+{
+  return g_build_filename (g_get_user_data_dir (), "chatty", "m52xq-chat-sim.ini", NULL);
+}
+
+static guint
+m52xq_sim_store_get (const char *number, const char *suffix)
+{
+  g_autoptr(GKeyFile) kf = g_key_file_new ();
+  g_autofree char *path = m52xq_sim_store_path ();
+  g_autofree char *key = NULL;
+
+  if (!number || !*number || !g_key_file_load_from_file (kf, path, G_KEY_FILE_NONE, NULL))
+    return 0;
+  key = g_strconcat (number, suffix, NULL);
+  return (guint) g_key_file_get_integer (kf, "chats", key, NULL);
+}
+
+static void
+m52xq_sim_store_set (const char *number, const char *suffix, guint slot)
+{
+  g_autoptr(GKeyFile) kf = g_key_file_new ();
+  g_autofree char *path = m52xq_sim_store_path ();
+  g_autofree char *dir = g_path_get_dirname (path);
+  g_autofree char *key = NULL;
+
+  if (!number || !*number)
+    return;
+  g_key_file_load_from_file (kf, path, G_KEY_FILE_KEEP_COMMENTS, NULL);
+  key = g_strconcat (number, suffix, NULL);
+  if ((guint) g_key_file_get_integer (kf, "chats", key, NULL) == slot)
+    return;
+  g_key_file_set_integer (kf, "chats", key, slot);
+  g_mkdir_with_parents (dir, 0700);
+  if (!g_key_file_save_to_file (kf, path, NULL))
+    g_warning ("m52xq: could not save %s", path);
+}
+
 static void
 chatty_mm_device_finalize (GObject *object)
 {
@@ -616,6 +676,11 @@ mm_account_add_sms (ChattyMmAccount *self,
                     MMSmsState       state)
 {
   g_autoptr(ChattyMessage) message = NULL;
+
+  /* m52xq dual SIM: replies go out on the SIM the last message came in on (unless chosen in the chat) */
+  if (state == MM_SMS_STATE_RECEIVED && m52xq_device_slot (device))
+    m52xq_sim_store_set (mm_sms_get_number (sms), ".last", m52xq_device_slot (device));
+
   g_autoptr(GDateTime) date_time = NULL;
   g_autoptr(ChattyMmBuddy) senderbuddy = NULL;
   ChattyChat *chat;
@@ -1647,7 +1712,24 @@ chatty_mm_account_send_message_async (ChattyMmAccount     *self,
   g_object_set_data_full (G_OBJECT (task), "chat", g_object_ref (chat),
                           g_object_unref);
 
-  device = g_list_model_get_item (G_LIST_MODEL (self->device_list), 0);
+  device = NULL;
+  {
+    /* m52xq dual SIM: the modem of the SIM of this chat, else the first modem (upstream) */
+    guint slot = chatty_mm_account_get_chat_sim (self, chat);
+
+    for (guint i = 0; slot && i < g_list_model_get_n_items (G_LIST_MODEL (self->device_list)); i++) {
+      ChattyMmDevice *d = g_list_model_get_item (G_LIST_MODEL (self->device_list), i);
+
+      if (m52xq_device_slot (d) == slot) {
+        device = d;
+        break;
+      }
+      g_object_unref (d);
+    }
+    CHATTY_TRACE_MSG ("m52xq: chat SIM %u, matching modem: %d", slot, !!device);
+  }
+  if (!device)
+    device = g_list_model_get_item (G_LIST_MODEL (self->device_list), 0);
   g_object_set_data_full (G_OBJECT (task), "device", device, g_object_unref);
 
   if (!device) {
@@ -1754,3 +1836,61 @@ chatty_mm_account_set_mms_settings_finish (ChattyMmAccount *self,
 
   return chatty_mmsd_set_settings_finish (self->mmsd, result, error);
 }
+
+
+/* m52xq dual SIM -------------------------------------------------------------------------------- */
+
+/**
+ * chatty_mm_account_get_n_sims:
+ *
+ * Returns: the number of modems with a SIM slot name ("SIM 1" / "SIM 2")
+ */
+guint
+chatty_mm_account_get_n_sims (ChattyMmAccount *self)
+{
+  guint n = 0;
+
+  g_return_val_if_fail (CHATTY_IS_MM_ACCOUNT (self), 0);
+
+  for (guint i = 0; i < g_list_model_get_n_items (G_LIST_MODEL (self->device_list)); i++) {
+    g_autoptr(ChattyMmDevice) d = g_list_model_get_item (G_LIST_MODEL (self->device_list), i);
+
+    if (m52xq_device_slot (d))
+      n++;
+  }
+  return n;
+}
+
+/**
+ * chatty_mm_account_get_chat_sim:
+ *
+ * Returns: the SIM (1 or 2) used to send in @chat: chosen in the chat, else the SIM of the last
+ *   incoming message of that number, else 0 (first modem)
+ */
+guint
+chatty_mm_account_get_chat_sim (ChattyMmAccount *self,
+                                ChattyChat      *chat)
+{
+  const char *name;
+  guint slot;
+
+  g_return_val_if_fail (CHATTY_IS_MM_ACCOUNT (self), 0);
+  if (!chat)
+    return 0;
+
+  name = chatty_chat_get_chat_name (chat);
+  slot = m52xq_sim_store_get (name, "");
+  if (!slot)
+    slot = m52xq_sim_store_get (name, ".last");
+  return slot <= 2 ? slot : 0;
+}
+
+void
+chatty_mm_account_set_chat_sim (ChattyMmAccount *self,
+                                ChattyChat      *chat,
+                                guint            slot)
+{
+  g_return_if_fail (CHATTY_IS_MM_ACCOUNT (self));
+  if (chat && slot <= 2)
+    m52xq_sim_store_set (chatty_chat_get_chat_name (chat), "", slot);
+}
