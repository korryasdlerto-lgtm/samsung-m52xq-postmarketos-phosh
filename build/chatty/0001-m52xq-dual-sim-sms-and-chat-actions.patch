+/* m52xq dual SIM: show the SIM the chat sends on; only for SMS chats with two SIM modems */
+static void
+m52xq_sim_button_update (ChattyMessageBar *self)
+{
+  ChattyAccount *account = self->chat ? chatty_chat_get_account (self->chat) : NULL;
+  g_autofree char *label = NULL;
+  guint slot;
+
+  if (!CHATTY_IS_MM_CHAT (self->chat) || !CHATTY_IS_MM_ACCOUNT (account) ||
+      chatty_mm_account_get_n_sims (CHATTY_MM_ACCOUNT (account)) < 2) {
+    gtk_widget_set_visible (self->m52xq_sim_button, FALSE);
+    return;
+  }
+
+  slot = chatty_mm_account_get_chat_sim (CHATTY_MM_ACCOUNT (account), self->chat);
+  label = g_strdup_printf ("SIM %u", slot ? slot : 1);
+  gtk_button_set_label (GTK_BUTTON (self->m52xq_sim_button), label);
+  gtk_widget_set_visible (self->m52xq_sim_button, TRUE);
+}
+
+static void
+m52xq_sim_button_clicked_cb (ChattyMessageBar *self)
+{
+  ChattyAccount *account = self->chat ? chatty_chat_get_account (self->chat) : NULL;
+  guint slot;
+
+  if (!CHATTY_IS_MM_ACCOUNT (account))
+    return;
+
+  slot = chatty_mm_account_get_chat_sim (CHATTY_MM_ACCOUNT (account), self->chat);
+  chatty_mm_account_set_chat_sim (CHATTY_MM_ACCOUNT (account), self->chat, slot == 2 ? 1 : 2);
+  m52xq_sim_button_update (self);
+}
+
